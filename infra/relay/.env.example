# Required: Relay API and managed tunnel domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Managed environment endpoints are provisioned below the tunnel zone.
# Both may name the same zone; zone.ts reuses one zone resource when they match.
RELAY_API_ZONE_NAME=example.com
RELAY_TUNNEL_ZONE_NAME=tunnels.example.com

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=relay.example.com

# Required: Relay Postgres origin
# A self-hosted Postgres fronted by Cloudflare Access and reached through a
# Cloudflare Tunnel. Hyperdrive connects with the Access service token below, so
# there is no port here: the tunnel's TCP ingress supplies it.
# This role is the Worker's, and holds only pg_read_all_data and
# pg_write_all_data. It must never be able to run DDL.
RELAY_DB_HOST=relaydb.example.com
RELAY_DB_USER=t3relay_runtime
RELAY_DB_PASSWORD=...
RELAY_DB_ACCESS_CLIENT_ID=....access
RELAY_DB_ACCESS_CLIENT_SECRET=...

# Required for `pnpm migrate`: the schema owner, and a second Access service
# token. Migrations run from the deploy host over `cloudflared access tcp`, so
# the relay needs no privileged DDL route. Keeping the operator token separate
# from Hyperdrive's means a compromised laptop does not force a Hyperdrive
# rotation.
RELAY_DB_ADMIN_USER=t3relay_owner
RELAY_DB_ADMIN_PASSWORD=...
RELAY_DB_ADMIN_ACCESS_CLIENT_ID=....access
RELAY_DB_ADMIN_ACCESS_CLIENT_SECRET=...

# Required: Clerk
# Get the keys from the Clerk Dashboard under API keys. Set the JWT audience to
# the `aud` claim configured on the `t3-relay` JWT template.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_AUDIENCE=t3-code-relay

# Apple Push Notification service (required unless APNS_ENABLED=false)
# Set APNS_ENABLED=false for an Android-only development relay.
# Get these values from your Apple Developer account. Use `sandbox` for
# development APNs credentials and `production` for production credentials.
# For a deployment without a mobile client, set APNS_ENABLED=false.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_BUNDLE_ID=...
APNS_PRIVATE_KEY=...

# Required: Axiom
# Creates the traces dataset, its ingest tokens and the recent-spans view.
AXIOM_ORG_ID=...
AXIOM_TOKEN=...
# Optional: Android push. Set this secret to the service account JSON from
# Firebase Project settings > Service accounts. Never put it in an app build.
# FCM_SERVICE_ACCOUNT={...}
