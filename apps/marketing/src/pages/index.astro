---
import "../styles/tokens.css";
import Layout from "../layouts/Layout.astro";
import Arming from "../components/sections/Arming.astro";
import Capture from "../components/sections/Capture.astro";
import Checks from "../components/sections/Checks.astro";
import Cta from "../components/sections/Cta.astro";
import Harness from "../components/sections/Harness.astro";
import Hero from "../components/sections/Hero.astro";
import Mission from "../components/sections/Mission.astro";
import Open from "../components/sections/Open.astro";
import State from "../components/sections/State.astro";
import Tape from "../components/sections/Tape.astro";
---

<Layout>
  <Hero />
  <Tape />
  <Mission />
  <Checks />
  <Harness />
  <Arming />
  <State />
  <Capture />
  <Open />
  <Cta />

  <!-- The section minimap rail: the app's chat-timeline minimap
       translated into page chrome (one tick per section, the
       in-view tick highlighted, click to jump, hover names). The
       permitted third script populates and drives it; empty and
       hidden until then so the landmark is never hollow. -->
  <nav class="minimap" aria-label="Page sections" hidden></nav>
</Layout>

<style is:global>
  /* The rail owns the right gutter on the desktop surface only -
     the same width where the price-line spine owns the left one.
     Fixed and pointer-events: none at the nav, auto on the ticks,
     so it never intercepts content or shifts layout.
     Visual grammar is the app's own TimelineMinimap
     (apps/web/src/components/chat/MessagesTimeline.tsx): small
     2px rounded ticks on a 1px hairline track, 8px apart, muted
     ink at rest, foreground ink for the section in view, and the
     width falling off with distance from the active tick
     (24/16/10/8px, exactly the app's w-6/w-4/w-2.5/w-2). */
  .minimap {
    position: fixed;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    padding: 3px 0;
    pointer-events: none;
  }

  /* The full-height hairline track the ticks sit on, the app's
     w-px bg-border/15 lane. */
  .minimap::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    right: 3px;
    width: 1px;
    background: color-mix(in srgb, var(--border) 55%, transparent);
  }

  @media (min-width: 1081px) {
    .minimap[hidden] {
      display: none;
    }

    .minimap {
      display: flex;
    }
  }

  .minimap-tick {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 28px;
    height: 8px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    pointer-events: auto;
  }

  /* The tick: h-0.5, rounded-full, muted-foreground/35 at rest,
    foreground/90 in view, width by distance - the app's own
    numbers. Plain color/width transitions: state changes, no
    repaint loops. */
  .tick-line {
    position: relative;
    width: 8px;
    height: 2px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--fg-muted) 35%, transparent);
    transition:
      width 0.15s ease,
      background-color 0.15s ease;
  }

  .minimap-tick[data-distance="2"] .tick-line {
    width: 10px;
  }

  .minimap-tick[data-distance="1"] .tick-line,
  .minimap-tick:hover .tick-line,
  .minimap-tick:focus-visible .tick-line {
    width: 16px;
    background: color-mix(in srgb, var(--fg-muted) 60%, transparent);
  }

  .minimap-tick[aria-current="true"] .tick-line {
    width: 24px;
    background: color-mix(in srgb, var(--fg) 90%, transparent);
  }

  /* The mission tick carries the story's progress: its ink fills
     left to right across the mission scroller's own contain pass,
     so the rail advances through the long pinned story instead of
     freezing on one bar. Declared here (page chrome's stylesheet,
     no section file touched); --mission is restated alongside so
     this rule never drops the name Mission's own block sets. */
  body .main .mission-scroller {
    view-timeline-name: --mission, --rail-mission;
  }

  body {
    timeline-scope: --rail-mission;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .minimap-tick[data-mission] .tick-line::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: color-mix(in srgb, var(--fg) 90%, transparent);
        transform-origin: 0 50%;
        transform: scaleX(0);
        animation: rail-mission-fill linear both;
        animation-timeline: --rail-mission;
        animation-range: contain 0% contain 100%;
      }

      @keyframes rail-mission-fill {
        from { transform: scaleX(0); }
        to { transform: scaleX(1); }
      }
    }
  }

  /* The hover name, docked left of its tick the way the app's
     minimap previews sit beside their ticks. */
  .tick-label {
    position: absolute;
    right: 34px;
    top: 50%;
    transform: translateY(-50%) translateX(4px);
    padding: 3px 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--fg-muted);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .minimap-tick:hover .tick-label,
  .minimap-tick:focus-visible .tick-label {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }
</style>

<script>
  import { fetchLatestRelease, RELEASES_URL } from "../lib/releases";

  async function initDownload() {
    const heroBtn = document.getElementById("download-btn") as HTMLAnchorElement | null;
    const ctaBtn = document.getElementById("cta-download-btn") as HTMLAnchorElement | null;
    const releaseLine = document.getElementById("hero-release");
    const releaseTag = document.getElementById("hero-release-tag");

    try {
      const release = await fetchLatestRelease();
      const dmg = (release?.assets ?? []).find((a) => a.name.endsWith("-arm64.dmg"));
      if (!dmg) throw new Error("no arm64 dmg in latest release");

      if (heroBtn) heroBtn.href = dmg.browser_download_url;
      if (ctaBtn) ctaBtn.href = dmg.browser_download_url;
      if (releaseLine && releaseTag && release?.tag_name) {
        releaseTag.textContent = release.tag_name;
        releaseLine.hidden = false;
      }
    } catch {
      if (heroBtn) heroBtn.href = RELEASES_URL;
      if (ctaBtn) ctaBtn.href = RELEASES_URL;
    }
  }

  /* Real mids from the Hyperliquid testnet API (the app trades testnet
     only; the tape must never quote mainnet prices under a testnet label).
     The band starts in a shimmering placeholder state and removes itself if
     the call fails, so it never shows a price that did not come from the
     exchange. */
  const INFO_URL = "https://api.hyperliquid-testnet.xyz/info";

  type AssetCtx = { midPx: string | null; prevDayPx: string | null };
  type MetaAndCtxs = [{ universe: { name: string }[] }, AssetCtx[]];

  function formatPrice(value: number) {
    const decimals = value >= 1000 ? 1 : value >= 1 ? 3 : 5;
    return value.toLocaleString("en-US", {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
    });
  }

  async function initTape() {
    const tape = document.getElementById("tape");
    if (!tape) return;

    try {
      const response = await fetch(INFO_URL, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ type: "metaAndAssetCtxs" }),
      });
      if (!response.ok) throw new Error(`hyperliquid info ${response.status}`);

      const [meta, contexts] = (await response.json()) as MetaAndCtxs;
      const bySymbol = new Map<string, AssetCtx>();
      meta.universe.forEach((asset, index) => {
        const context = contexts[index];
        if (context) bySymbol.set(asset.name, context);
      });

      let filled = 0;
      for (const item of tape.querySelectorAll<HTMLElement>(".tape-item")) {
        const context = bySymbol.get(item.dataset.symbol ?? "");
        const mid = Number(context?.midPx);
        const prev = Number(context?.prevDayPx);
        if (!Number.isFinite(mid) || mid <= 0) {
          item.remove();
          continue;
        }

        const priceEl = item.querySelector(".tape-px");
        const changeEl = item.querySelector(".tape-chg");
        if (priceEl) priceEl.textContent = formatPrice(mid);

        if (changeEl && Number.isFinite(prev) && prev > 0) {
          const change = ((mid - prev) / prev) * 100;
          changeEl.textContent = `${change >= 0 ? "+" : ""}${change.toFixed(2)}%`;
          changeEl.classList.add(change >= 0 ? "is-up" : "is-down");
        } else if (changeEl) {
          changeEl.remove();
        }
        filled += 1;
      }

      tape.dataset.state = filled > 0 ? "live" : "empty";
      if (filled === 0) tape.closest("section")?.remove();
    } catch {
      tape.dataset.state = "empty";
      tape.closest("section")?.remove();
    }
  }

  /* One pointer listener for the whole grid of tiles. It writes two custom
     properties and nothing else, so hover lighting costs no layout work. */
  function initTileSpotlight() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia("(hover: none)").matches) return;

    for (const tile of document.querySelectorAll<HTMLElement>(".tile")) {
      tile.addEventListener(
        "pointermove",
        (event) => {
          const box = tile.getBoundingClientRect();
          tile.style.setProperty("--mx", `${event.clientX - box.left}px`);
          tile.style.setProperty("--my", `${event.clientY - box.top}px`);
        },
        { passive: true },
      );
    }
  }

  /* The section minimap rail: the app's chat-timeline minimap as
     page chrome. Ticks are built from the sections that actually
     rendered (the tape removes itself if the exchange call
     fails, and its tick goes with it), the in-view tick tracks a
     center band via IntersectionObserver - a section-entering
     fact, not a scroll-position read - and jumps honor
     prefers-reduced-motion. */
  function initMinimap() {
    const rail = document.querySelector<HTMLElement>(".minimap");
    if (!rail) return;

    const names: Record<string, string> = {
      hero: "Top",
      "sec-tape": "Markets",
      "sec-mission": "Mission",
      "sec-checks": "Entry checks",
      "sec-harness": "Agent CLIs",
      "sec-arming": "Arming",
      "sec-state": "Alpha scope",
      "sec-capture": "Live capture",
      "sec-open": "Open source",
      "sec-cta": "Download",
    };

    const sections = Array.from(document.querySelectorAll<HTMLElement>("main > section"));
    if (sections.length === 0) return;

    const ticks = sections.map((section, index) => {
      const name = names[section.className.split(" ")[0] ?? ""] ?? `Section ${index + 1}`;
      const tick = document.createElement("button");
      tick.type = "button";
      tick.className = "minimap-tick";
      tick.setAttribute("aria-label", `Jump to ${name}`);
      if (section.classList.contains("sec-mission")) tick.dataset.mission = "true";
      tick.innerHTML = '<span class="tick-line" aria-hidden="true"></span>';
      const label = document.createElement("span");
      label.className = "tick-label";
      label.textContent = name;
      tick.appendChild(label);
      tick.addEventListener("click", () => {
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        /* "instant", not "auto": the page sets
           scroll-behavior: smooth on html, and "auto" means "use
           the CSS property", which would smooth-scroll right over
           the reduced-motion preference. */
        section.scrollIntoView({ behavior: reduced ? "instant" : "smooth", block: "start" });
      });
      rail.appendChild(tick);
      return tick;
    });
    rail.hidden = false;

    const inView = new Set<number>();
    /* The app's grammar: the active tick is widest and brightest,
       its neighbours step down by distance (w-6 / w-4 / w-2.5 /
       w-2), rendered via data-distance. */
    const setActive = () => {
      const active = inView.size === 0 ? -1 : Math.min(...inView);
      for (const [index, tick] of ticks.entries()) {
        if (index === active) {
          tick.setAttribute("aria-current", "true");
          tick.dataset.distance = "0";
        } else {
          tick.removeAttribute("aria-current");
          const distance = active < 0 ? 3 : Math.min(Math.abs(index - active), 3);
          tick.dataset.distance = String(distance);
        }
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const index = sections.indexOf(entry.target as HTMLElement);
          if (index < 0) continue;
          if (!entry.target.isConnected) {
            /* The section removed itself (the tape's failure
               path); retire its tick. */
            ticks[index]?.remove();
            inView.delete(index);
            continue;
          }
          if (entry.isIntersecting) inView.add(index);
          else inView.delete(index);
        }
        setActive();
      },
      /* The center band: a section counts as in view while it
         crosses the middle of the viewport, which is where the
         reader's eye actually is. */
      { rootMargin: "-40% 0px -40% 0px" },
    );

    for (const section of sections) observer.observe(section);
  }

  initDownload();
  initTape();
  initTileSpotlight();
  initMinimap();
</script>
