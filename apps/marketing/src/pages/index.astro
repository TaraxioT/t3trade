---
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL, UPSTREAM_REPOSITORY_URL } from "../lib/site";

/* Headlines resolve one word at a time as the section scrolls past, so each
   word needs its own slice of the shared view timeline. */
function kineticWords(sentence: string) {
  return sentence.split(" ").map((word, index) => ({
    word,
    range: `entry ${10 + index * 3}% cover ${36 + index * 3}%`,
  }));
}

/* ── The mission console ───────────────────────────────────────────────────
   Every level, size, and dollar figure below is from the ETH mission in the
   hero screenshot, so the console and the screenshot describe the same run.
   The candles between those levels are drawn from a fixed seed at build time:
   the levels are the record, the shape between them is an illustration. */
const MISSION = {
  market: "ETH",
  leverage: "20x",
  side: "Long",
  size: 2.1766,
  entry: 1883.54,
  stop: 1874.94,
  wake: 1879.21,
  trigger: 1882.76,
  mark: 1888.8,
  target: 1907,
  liquidation: 1471.34,
  margin: 206,
};

const risk = (MISSION.entry - MISSION.stop) * MISSION.size; // 18.72
const reward = (MISSION.target - MISSION.entry) * MISSION.size; // 51.06
const open = (MISSION.mark - MISSION.entry) * MISSION.size; // 11.45

const usd = (value: number) => `${value >= 0 ? "+" : "-"}$${Math.abs(value).toFixed(2)}`;
const px = (value: number) =>
  value.toLocaleString("en-US", { maximumFractionDigits: 2 });
const rr = reward / risk;

/* The drawdown the position has to survive on the way to the target. It comes
   within six dollars of the stop without touching it, which is the whole
   argument for putting the stop on the exchange in the first place. */
const DIP_PRICE = 1880.4;
const dipPnl = (DIP_PRICE - MISSION.entry) * MISSION.size; // -6.84

const CANDLE_COUNT = 48;
const BREAK_INDEX = 33;

/* Anchored walk: a range, a shakeout under it, the reclaim, then the run. */
const ANCHORS: [number, number][] = [
  [0, 1881.2], [8, 1883.1], [14, 1880.4], [22, 1882.6], [27, 1877.1],
  [31, 1880.6], [33, 1883.6], [37, 1885.9], [41, 1887.3], [45, 1888.3], [47, 1888.8],
];

function missionSeries() {
  let seed = 20260814;
  const rand = () => {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 2147483648;
  };

  const at = (index: number) => {
    for (let a = 0; a < ANCHORS.length - 1; a += 1) {
      const [i0, p0] = ANCHORS[a];
      const [i1, p1] = ANCHORS[a + 1];
      if (index <= i1) return p0 + ((p1 - p0) * (index - i0)) / (i1 - i0);
    }
    return ANCHORS[ANCHORS.length - 1][1];
  };

  return Array.from({ length: CANDLE_COUNT }, (_, index) => {
    const openPrice = at(index) + (rand() - 0.5) * 0.5;
    const closePrice = at(index + 1) + (rand() - 0.5) * 0.5;
    return {
      open: openPrice,
      close: closePrice,
      high: Math.max(openPrice, closePrice) + rand() * 0.55,
      low: Math.min(openPrice, closePrice) - rand() * 0.55,
      up: closePrice >= openPrice,
    };
  });
}

const candles = missionSeries();

/* The domain reaches the target, so the whole arc fits in one frame: a tight
   range along the bottom, the break out of it, and a run that climbs most of
   the height. The recorded candles hold the left of the plot and the plan
   that follows them holds the right. */
const CHART_W = 900;
const CHART_H = 520;
const P_MIN = 1873.4;
const P_MAX = 1909.6;
const GUTTER = 104; // right-hand room for the level labels
const PLOT_W = CHART_W - GUTTER;
/* The record takes a little under three fifths of the plot, which leaves the
   plan enough room to print at the same candle width the record uses. One
   grid across the whole chart, no seam. */
const CANDLE_W = PLOT_W * 0.58;
const SLOT = CANDLE_W / CANDLE_COUNT;
const yOf = (price: number) => CHART_H - ((price - P_MIN) / (P_MAX - P_MIN)) * CHART_H;
const xOf = (index: number) => index * SLOT + SLOT / 2;

const runPath = candles
  .slice(BREAK_INDEX)
  .map((candle, index) => `${index === 0 ? "M" : "L"}${xOf(BREAK_INDEX + index).toFixed(1)} ${yOf(candle.close).toFixed(1)}`)
  .join(" ");

/* Where the record stops and the plan starts. The mark is the last price the
   exchange actually reported; everything to its right is what the target and
   the stop commit the mission to, drawn dashed and labelled as a plan. */
/* The low sits at t = 0.5 so the wipe uncovers it on the same scroll step the
   PnL reel bottoms out. The number and the line hit their worst point
   together, which is the whole reason the drawdown is here. */
/* Neither half of the run is a straight line. On the way down two bounces
   fail before the low; on the way up the break is retested and the run pulls
   back twice before the target prints. */
const PLAN: [number, number][] = [
  [0.0, MISSION.mark],
  [0.09, 1886.4],
  [0.18, 1888.2],
  [0.28, 1884.1],
  [0.37, 1886.3],
  [0.44, 1882.0],
  [0.5, DIP_PRICE],
  [0.57, 1885.0],
  [0.63, 1883.2],
  [0.71, 1890.8],
  [0.77, 1888.4],
  [0.85, 1897.9],
  [0.91, 1895.0],
  [1.0, MISSION.target],
];
const planX = (t: number) => CANDLE_W + (PLOT_W - CANDLE_W) * t;

/* One stroke per leg rather than one line for the whole plan, because the
   direction it is heading is the story. A single accent stroke made a fall
   look the same as a climb. */
const PLAN_RUNS = PLAN.slice(0, -1).map(([t0, p0], index) => {
  const [t1, p1] = PLAN[index + 1];
  return {
    d: `M${planX(t0).toFixed(1)} ${yOf(p0).toFixed(1)} L${planX(t1).toFixed(1)} ${yOf(p1).toFixed(1)}`,
    up: p1 >= p0,
  };
});

const DIP_X = planX(0.5);
const TARGET_X = planX(1);

/* The record stops at the mark, but the chart should not. The plan prints as
   candles too, so the right half reads the same way the left half does and
   each one takes the colour of the direction it closed. They are hollow
   because none of them has happened yet. */
/* The plan sits on the record's own grid: same slot, same width, continuing
   from the last recorded index. One chart, not two charts side by side. */
const PROJ_COUNT = Math.floor((PLOT_W - CANDLE_W) / SLOT);
const tAtX = (x: number) =>
  Math.min(1, Math.max(0, (x - CANDLE_W) / (PLOT_W - CANDLE_W)));

const planPriceAt = (t: number) => {
  for (let index = 0; index < PLAN.length - 1; index += 1) {
    const [t0, p0] = PLAN[index];
    const [t1, p1] = PLAN[index + 1];
    if (t <= t1) return p0 + ((p1 - p0) * (t - t0)) / (t1 - t0);
  }
  return PLAN[PLAN.length - 1][1];
};

/* The same seeded walk the record uses, down to the jitter and wick figures.
   Interpolating the plan on its own gave every candle in a leg the same body,
   and a wider jitter made the plan half look like a rougher market than the
   half it continues. */
const projected = (() => {
  let seed = 20260816;
  const rand = () => {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 2147483648;
  };

  return Array.from({ length: PROJ_COUNT }, (_, index) => {
    const x = xOf(CANDLE_COUNT + index);
    const openPrice = planPriceAt(tAtX(x - SLOT / 2)) + (rand() - 0.5) * 0.5;
    const closePrice = planPriceAt(tAtX(x + SLOT / 2)) + (rand() - 0.5) * 0.5;
    return {
      x,
      high: Math.max(openPrice, closePrice) + rand() * 0.55,
      low: Math.min(openPrice, closePrice) - rand() * 0.55,
      top: yOf(Math.max(openPrice, closePrice)),
      bottom: yOf(Math.min(openPrice, closePrice)),
      up: closePrice >= openPrice,
    };
  });
})();

/* The agent log, told the way the app's own log panel prints it: a timestamp,
   a tone rail, and one line per event. Each row owns the same slice of the
   pinned scroll that its chart annotation owns, so the feed and the chart
   never disagree about what has happened yet. */
type LogTone = "info" | "armed" | "profit" | "loss" | "plan";
const LOG: { at: number; time: string; tone: LogTone; text: string; sub?: string }[] = [
  { at: 3, time: "14:02", tone: "info", text: "Mission created for ETH-PERP", sub: "long only · 20x ceiling, $50 loss budget" },
  { at: 9, time: "14:03", tone: "plan", text: "Plan published: long the range break", sub: `entry ${px(MISSION.entry)}, stop ${px(MISSION.stop)}, target ${px(MISSION.target)}` },
  { at: 18, time: "14:04", tone: "armed", text: `Watch armed · mark crosses ${px(MISSION.trigger)}`, sub: "the thread sleeps, spending nothing" },
  { at: 32, time: "15:41", tone: "armed", text: "Watch fired. Thread woken", sub: "fresh account, book, and budget data" },
  { at: 39, time: "15:41", tone: "info", text: "17/17 preview checks passed", sub: "order signed locally" },
  { at: 47, time: "15:41", tone: "profit", text: `Filled ${MISSION.size} ETH at ${px(MISSION.entry)}` },
  { at: 53, time: "15:42", tone: "loss", text: `Reduce-only stop resting at ${px(MISSION.stop)}`, sub: `risks ${usd(-risk)}, on the exchange itself` },
  { at: 76, time: "16:58", tone: "loss", text: `Drawdown to ${px(DIP_PRICE)}, ${usd(dipPnl)} unrealised`, sub: "the stop holds. Nothing is sold" },
  { at: 91, time: "17:24", tone: "profit", text: `Target ${px(MISSION.target)} printed. Position closed`, sub: `${usd(reward)} banked · ${rr.toFixed(1)}:1 as planned` },
];

/* The sidebar the way the app draws it: this mission's thread lit, two older
   ones resting below it. The live row's status walks the same timeline the
   log does. */
const SIDE_THREADS = [
  { title: "Short SOL into funding flip", meta: "settled · 2d" },
  { title: "BTC range scalp, 15m", meta: "settled · 4d" },
];

/* The phase strip across the top of the thread, the app's own breadcrumb.
   Each phase lights on the beat the mission enters it. */
const PHASES = [
  { label: "Planning", at: 3 },
  { label: "Armed", at: 18 },
  { label: "Live", at: 47 },
  { label: "Settled", at: 91 },
];

/* Beats carry their slice as two custom properties. The pinned desktop
   layout maps them onto the `contain` range, and the un-pinned mobile layout
   maps the same numbers onto `cover`, so one set of timings drives both. */
const span = (from: number, to: number) => `--from:${from}%;--to:${to}%`;

/* The PnL walks the whole arc on one reel: up to the open figure, down
   through the drawdown, then out to the target. Each stop on the reel carries
   its own colour, so the number goes red when the position is under water
   without any extra machinery. */
const ramp = (from: number, to: number, steps: number) =>
  Array.from({ length: steps }, (_, step) => from + ((to - from) * (step + 1)) / steps);

const RUN_STEPS = 10;
const DIP_STEPS = 8;
const TARGET_STEPS = 14;
const PNL_STEPS = RUN_STEPS + DIP_STEPS + TARGET_STEPS; // 32

const pnlArc = [
  0,
  ...ramp(0, open, RUN_STEPS),
  ...ramp(open, dipPnl, DIP_STEPS),
  ...ramp(dipPnl, reward, TARGET_STEPS),
];

/* Progress toward the target, floored at zero. Below the entry there is no
   progress to report, and a negative percentage reads as a bug. */
const pctArc = pnlArc.map((value) => Math.max(0, Math.round((value / reward) * 100)));

/* Return on the margin the position ties up, which is the second figure the
   app's header prints next to the dollar one. It is the same reel divided by
   the same margin, so the two numbers can never disagree. */
const roiArc = pnlArc.map(
  (value) => `${value >= 0 ? "+" : "-"}${Math.abs((value / MISSION.margin) * 100).toFixed(2)}%`,
);

/* The mark the PnL implies, so the readout never claims a price and a profit
   that disagree. Step zero is the fill and the last step is the target. */
const markArc = pnlArc.map((value) => px(MISSION.entry + value / MISSION.size));

/* The reel's two phase boundaries, RUN_STEPS/PNL_STEPS and
   (RUN_STEPS + DIP_STEPS)/PNL_STEPS, land at 31.25% and 56.25%. The
   progress-arc keyframes below bend at those same stops, so retiming the reel
   means retiming that keyframe too. */

/* Each watch is armed on the beat the agent registers it and met on the beat
   the market satisfies it. The second one never fires, which is the point:
   the drawdown bottoms out above it and nothing wakes the thread. */
/* `reads` is the reel that supplies the row's observed value, the way the app
   prints the live reading a condition is measured against. A candle close has
   no continuous reading, so that row shows an em dash, exactly as the app
   does when a condition has nothing to observe yet. */
const armedWatches = [
  { label: `ETH mark crosses above ${px(MISSION.trigger)}`, armedAt: 21, metAt: 32, reads: "mark" },
  { label: `ETH 15m candle closes below ${px(MISSION.wake)}`, armedAt: 59, metAt: null, reads: null },
  { label: `ETH unrealised PnL reaches ${usd(reward)}`, armedAt: 60, metAt: 92, reads: "pnl" },
];

/* The schedule strip the app draws under the chart: what can happen next, in
   the order it can arrive. Every figure here is one of the mission's own
   levels — nothing is a distance that would have to move with the mark. */
const upNext = [
  { label: `stop ${px(MISSION.stop)}`, detail: `$${risk.toFixed(2)} risk`, at: 52 },
  { label: `wake @ ${px(MISSION.wake)}`, detail: null, at: 59 },
  { label: `bank at ${usd(reward)}`, detail: null, at: 60 },
];

/* What the position is, at the foot of the panel: one wrapping line of
   `label value` pairs. The stop is not among them — it belongs to the
   schedule above, and a figure appears exactly once. */
const heldStats = [
  { term: "Size", value: MISSION.size.toFixed(4), at: 46 },
  { term: "Entry", value: px(MISSION.entry), at: 46 },
  { term: "Mark", value: null, at: 63 },
  { term: "Liq", value: px(MISSION.liquidation), at: 55 },
  { term: "Protected", value: "Full", at: 53 },
  { term: "Margin", value: `$${MISSION.margin}`, at: 48 },
];

/* Six of the seventeen, named the way the preview tool names them. */
const previewChecks = [
  { label: "mission active, entries allowed", detail: "authority current" },
  { label: "market, side, and leverage allowed", detail: "within mandate" },
  { label: "account and order book fresh", detail: "live exchange data" },
  { label: "size, price, and minimum valid", detail: "exchange rules" },
  { label: "position and mission risk available", detail: "usd loss budget" },
  { label: "reduce-only stop attached", detail: "required" },
];

const controls = ["Pause", "Cancel entries", "Reduce 50%", "Close", "Revoke"];

/* Rendered as placeholders and filled in from the Hyperliquid testnet API on
   the client. If that call fails the band removes itself rather than show a
   number nobody can verify. */
const tapeMarkets = ["BTC", "ETH", "SOL", "HYPE", "AVAX", "LINK", "ARB", "DOGE"];

const harnesses = [
  { name: "Claude Code", command: "claude auth login", trades: true, icon: "claude-ai-icon.svg" },
  { name: "Codex CLI", command: "codex login", trades: true, icon: "openai_dark.svg" },
  { name: "OpenCode", command: "opencode auth login", trades: true, icon: "opencode-dark.svg" },
  { name: "Cursor", command: "agent login", trades: false, icon: "cursor_light.svg" },
  { name: "Grok CLI", command: "grok login", trades: false, icon: "grok-dark.svg" },
];
---

<Layout>
  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="container hero-inner">
      <p class="eyebrow hero-eyebrow">Open source · alpha · Hyperliquid testnet</p>

      <h1 class="hero-title display">
        The trading interface<br />for coding agents.
      </h1>

      <p class="hero-sub">
        Give an agent a mandate in plain English. T3 Trade holds it to hard limits and signs
        every order locally.
      </p>

      <div class="hero-actions">
        <a id="download-btn" href="https://github.com/TaraxioT/t3trade/releases" class="btn btn-primary btn-lg">
          <svg class="dl-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
          <span>Download for macOS</span>
        </a>
        <a class="hero-source-link" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
          <span>Run from source</span>
          <svg class="hero-source-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ── Mission lifecycle ─────────────────────────────────────── -->
  <section id="missions" class="sec-mission">
    <div class="container">
      <h2 class="section-title kinetic">
        {kineticWords("Watch one mission run.").map(({ word, range }) => (
          <>
            <span style={`animation-range: ${range}`}>{word}</span>{" "}
          </>
        ))}
      </h2>
      <p class="section-lede scrub">
        A mission binds one agent thread to one market. This is the cockpit itself, replaying
        a testnet ETH run: keep scrolling and the log fills, the watch fires, the checks
        pass, and the chart earns its target.
      </p>
    </div>

    <!-- The window pins for the length of the story. Each beat owns a slice
         of this timeline, and the log, the chart, and the readout all move
         together on it. The dim layer behind the window is what makes the
         page recede while the app plays. -->
    <div class="mission-scroller">
      <div class="mission-sticky">
        <div class="mission-dim" aria-hidden="true"></div>
        <div class="container stage-container">
          <div class="appwin">
            <div class="appwin-titlebar">
              <span class="tl-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="tl-title">T3 Trade</span>
              <span class="tl-net">hyperliquid testnet</span>
            </div>

            <div class="appwin-body">
              <!-- The sidebar, the way the app draws it: this mission's thread
                   lit and walking through its states, older threads at rest. -->
              <aside class="appwin-side" aria-hidden="true">
                <div class="side-legend">Threads</div>
                <div class="side-thread side-thread--live">
                  <span class="side-thread-title">Trade ETH on the 5m, long the range break</span>
                  <span class="side-status">
                    <span class="status-window"><span class="status-reel">
                      <span class="status-step"><i class="status-dot status-dot--wait"></i>waiting</span>
                      <span class="status-step status-step--armed"><i class="status-dot status-dot--armed"></i>armed</span>
                      <span class="status-step status-step--long"><i class="status-dot status-dot--long"></i>ETH · long 20x</span>
                      <span class="status-step status-step--won"><i class="status-dot status-dot--long"></i>{usd(reward)} · settled</span>
                    </span></span>
                  </span>
                </div>
                {SIDE_THREADS.map((thread) => (
                  <div class="side-thread">
                    <span class="side-thread-title">{thread.title}</span>
                    <span class="side-thread-meta">{thread.meta}</span>
                  </div>
                ))}
              </aside>

              <!-- The thread column: phase strip, the agent log filling row by
                   row, and the composer holding the mandate that started it. -->
              <div class="appwin-thread">
                <div class="thread-phases" aria-hidden="true">
                  {PHASES.map((phase, index) => (
                    <>
                      {index === 0 ? null : <span class="phase-sep">›</span>}
                      <span class="phase-word" style={`${span(phase.at, phase.at + 4)}`}>{phase.label}</span>
                    </>
                  ))}
                </div>

                <div class="log-feed">
                  <div class="log-mandate">
                    <span class="log-mandate-label">you</span>
                    <p>
                      Trade ETH on the 5m. Long only, 20x ceiling, $50 max loss. Wait for the
                      range break, protect every entry, and bank the target.
                    </p>
                  </div>

                  {LOG.map((row) => (
                    <div class={`log-row log-row--${row.tone}`} style={`${span(row.at, row.at + 5)}`}>
                      <span class="log-time">{row.time}</span>
                      <span class="log-rail" aria-hidden="true"></span>
                      <span class="log-text">
                        {row.text}
                        {row.sub && <span class="log-sub">{row.sub}</span>}
                      </span>
                    </div>
                  ))}
                </div>

                <div class="composer" aria-hidden="true">
                  <span class="composer-line">Reply to the mission thread<span class="composer-caret"></span></span>
                  <span class="composer-meta">
                    <span>Codex · high</span>
                    <span class="composer-chip">ETH</span>
                  </span>
                </div>
              </div>

              <!-- The market column: the chart card and the live position
                   panel, stacked the way the cockpit stacks them. -->
              <div class="appwin-market">
            <figure class="console-chart">
              <div class="chart-head">
                <span class="chart-market">
                  <span class="chart-legend">ETH-PERP</span>
                  <span class="chart-price">
                    <span class="pnl-window"><span class="mark-reel" style={`${span(63, 92)}`}>
                      {markArc.map((value) => <span class="pnl-step">{value}</span>)}
                    </span></span>
                  </span>
                </span>
                <span class="chart-interval">5m</span>
              </div>
              <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="chart-svg" role="img"
                aria-label={`Price chart of the ETH mission: a range, a break above ${px(MISSION.trigger)}, an entry at ${px(MISSION.entry)}, a stop at ${px(MISSION.stop)}, and a target at ${px(MISSION.target)}.`}>

                <!-- A price grid, so the room above the range reads as
                     distance rather than empty canvas. -->
                {[1880, 1890, 1900].map((price, index) => (
                  <g class="grid" style={`${span(1 + index, 6 + index)}`}>
                    <line x1="0" x2={CHART_W} y1={yOf(price)} y2={yOf(price)} />
                    <text x={CHART_W - 6} text-anchor="end" y={yOf(price) - 5}>{price}</text>
                  </g>
                ))}

                <!-- The target is part of the mandate, so it is on the chart
                     from the first beat. Everything between it and the range
                     is the distance this mission exists to cover. -->
                <g class="level level--target" style={`${span(4, 10)}`}>
                  <line x1="0" x2={CHART_W} y1={yOf(MISSION.target)} y2={yOf(MISSION.target)} />
                  <text x="8" y={yOf(MISSION.target) - 9}>target {px(MISSION.target)}</text>
                </g>

                <!-- The two bands the order is signed between, each drawn on
                     the beat that commits to it. Below the entry is the money
                     the stop is defending; above it is what the target pays. -->
                <rect class="zone zone--risk" x="0" width={CHART_W}
                  y={yOf(MISSION.entry)} height={yOf(MISSION.stop) - yOf(MISSION.entry)}
                  style={`${span(53, 60)}`} />
                <rect class="zone zone--reward" x="0" width={CHART_W}
                  y={yOf(MISSION.target)} height={yOf(MISSION.entry) - yOf(MISSION.target)}
                  style={`${span(58, 66)}`} />

                {candles.map((candle, index) => {
                  const x = xOf(index);
                  const top = yOf(Math.max(candle.open, candle.close));
                  const bottom = yOf(Math.min(candle.open, candle.close));
                  /* Three phases, so the chart never shows a candle before the
                     story has reached it: the range prints through the wait,
                     the break candle prints alone on the beat the watch fires,
                     and the rest hold until the order is signed and protected.
                     The pause between them is the agent working. */
                  const from = index < BREAK_INDEX
                    ? 2 + index * 0.5
                    : index === BREAK_INDEX
                      ? 32
                      : 56 + (index - BREAK_INDEX - 1) * 0.9;
                  return (
                    <g class={`candle ${candle.up ? "candle--up" : "candle--down"}`}
                      style={`${span(from, from + 5)}; transform-origin: ${x.toFixed(1)}px ${bottom.toFixed(1)}px`}>
                      <line class="candle-wick" x1={x} x2={x} y1={yOf(candle.high)} y2={yOf(candle.low)} />
                      <rect class="candle-body" x={x - SLOT * 0.32} width={SLOT * 0.64}
                        y={top} height={Math.max(1.4, bottom - top)} />
                    </g>
                  );
                })}

                <!-- Levels, each drawn on the beat that creates it. -->
                <g class="level level--trigger" style={`${span(21, 28)}`}>
                  <line x1="0" x2={CHART_W} y1={yOf(MISSION.trigger)} y2={yOf(MISSION.trigger)} />
                  <text x="8" y={yOf(MISSION.trigger) - 8}>watch · mark crosses {px(MISSION.trigger)}</text>
                </g>

                <g class="level level--entry" style={`${span(45, 52)}`}>
                  <line x1="0" x2={CHART_W} y1={yOf(MISSION.entry)} y2={yOf(MISSION.entry)} />
                  <text x={CHART_W - 8} text-anchor="end" y={yOf(MISSION.entry) - 8}>entry {px(MISSION.entry)}</text>
                </g>

                <g class="level level--stop" style={`${span(52, 59)}`}>
                  <line x1="0" x2={CHART_W} y1={yOf(MISSION.stop)} y2={yOf(MISSION.stop)} />
                  <text x="8" y={yOf(MISSION.stop) + 18}>stop {px(MISSION.stop)} · risks {usd(-risk)}</text>
                </g>

                <!-- Once the size is signed the target has a dollar value, so
                     it gets one. -->
                <text class="target-pays" x="8" y={yOf(MISSION.target) + 17}
                  style={`${span(58, 65)}`}>pays {usd(reward)} at this size</text>

                <!-- The second watch is only armed once there is a position
                     to defend, so it draws after the stop. -->
                <g class="level level--wake" style={`${span(59, 66)}`}>
                  <line x1="0" x2={CHART_W} y1={yOf(MISSION.wake)} y2={yOf(MISSION.wake)} />
                  <text x={CHART_W - 8} text-anchor="end" y={yOf(MISSION.wake) + 16}>wake @ {px(MISSION.wake)}</text>
                </g>

                <!-- The break candle pulses on the beat the watch fires. -->
                <circle class="fire-ping" cx={xOf(BREAK_INDEX)} cy={yOf(MISSION.trigger)} r="7"
                  style={`${span(32, 40)}`} />
                <circle class="fire-dot" cx={xOf(BREAK_INDEX)} cy={yOf(MISSION.trigger)} r="3.5"
                  style={`${span(32, 38)}`} />

                <path class="chart-run" d={runPath} pathLength="1" style={`${span(57, 70)}`} />

                <circle class="mark-dot" r="4.5" cx={xOf(CANDLE_COUNT - 1)} cy={yOf(MISSION.mark)}
                  style={`${span(66, 70)}`} />

                <!-- Everything right of the mark is the plan, not the record.
                     It is dashed for that reason, and it is revealed rather
                     than drawn so the dashes survive. -->
                <g class="plan" style={`${span(68, 92)}`}>
                  {PLAN_RUNS.map((run) => (
                    <path class={`plan-path ${run.up ? "plan-path--up" : "plan-path--down"}`} d={run.d} />
                  ))}
                </g>

                <!-- The plan as candles. Each one prints in step with the wipe
                     above it and carries the colour of its own direction, so
                     the drawdown turns the chart red as it happens. -->
                {projected.map((candle, index) => {
                  const from = 68 + (index * 24) / PROJ_COUNT;
                  return (
                    <g class={`proj-candle ${candle.up ? "candle--up" : "candle--down"}`}
                      style={`${span(from, from + 2.6)}; transform-origin: ${candle.x.toFixed(1)}px ${candle.bottom.toFixed(1)}px`}>
                      <line class="proj-wick" x1={candle.x} x2={candle.x}
                        y1={yOf(candle.high)} y2={yOf(candle.low)} />
                      <rect class="proj-body" x={candle.x - SLOT * 0.32} width={SLOT * 0.64}
                        y={candle.top} height={Math.max(1.6, candle.bottom - candle.top)} />
                    </g>
                  );
                })}

                <!-- The drawdown. The position goes under water, comes within
                     six dollars of the stop, and the stop is never touched. -->
                <g class="dip" style={`${span(76, 80)}`}>
                  <circle class="dip-dot" cx={DIP_X} cy={yOf(DIP_PRICE)} r="4" />
                  <line class="dip-drop" x1={DIP_X} x2={DIP_X}
                    y1={yOf(DIP_PRICE)} y2={yOf(MISSION.stop)} />
                  <text class="dip-label" x={DIP_X - 9} text-anchor="end" y={yOf(DIP_PRICE) + 5}>
                    {usd(dipPnl)}
                  </text>
                </g>

                <!-- The stop flares at the low, because that is the moment it
                     is the only thing between the position and the budget. -->
                <line class="stop-hold" x1="0" x2={CHART_W}
                  y1={yOf(MISSION.stop)} y2={yOf(MISSION.stop)} style={`${span(77, 84)}`} />
                <text class="stop-hold-label" x={DIP_X + 10} y={yOf(MISSION.stop) - 9}
                  style={`${span(78, 83)}`}>stop holds</text>

                <!-- The target prints. -->
                <g class="target-hit" style={`${span(91, 96)}`}>
                  <circle class="target-ping" cx={TARGET_X} cy={yOf(MISSION.target)} r="20" />
                  <circle class="target-dot" cx={TARGET_X} cy={yOf(MISSION.target)} r="18" />
                  <g class="target-check" style={`${span(92, 96)}`}
                    transform={`translate(${(TARGET_X - 18).toFixed(1)} ${(yOf(MISSION.target) - 18).toFixed(1)}) scale(2.25)`}>
                    <path d="M3.4 8.5 6.6 11.6 12.6 4.8" pathLength="1" />
                  </g>
                </g>

                <!-- What the whole run was for, at the size the page has been
                     quoting all along. It lands after the tick draws. -->
                <text class="payoff" x="256" y="196" text-anchor="middle"
                  style={`${span(92, 98)}`}>{usd(reward)}</text>
              </svg>

              <!-- What the two levels are actually worth, to scale. Both bars
                   are measured outward from the entry, in the order the run
                   creates them: the stop caps the downside first, then the
                   target opens the upside. -->
              <figcaption class="rr">
                <span class="rr-bar">
                  <span class="rr-seg rr-seg--risk" style={`flex: ${risk}; ${span(53, 59)}`}>
                    <span class="rr-cap">stop</span>
                    <span class="rr-val">{usd(-risk)}</span>
                  </span>
                  <span class="rr-seg rr-seg--reward" style={`flex: ${reward}; ${span(58, 65)}`}>
                    <span class="rr-cap">target</span>
                    <span class="rr-val">{usd(reward)}</span>
                  </span>
                </span>
                <span class="rr-note">
                  <svg class="tick" style={`${span(65, 69)}`} viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3.4 8.5 6.6 11.6 12.6 4.8" pathLength="1" />
                  </svg>
                  <span><strong>{rr.toFixed(1)}:1</strong> planned. Both sides are fixed before
                  the order is signed, so neither one moves later.</span>
                </span>
              </figcaption>
            </figure>

            <!-- The position readout, drawn as the app's live panel draws it:
                 the header figures, then the schedule, then the armed
                 checklist, then what is held. Same bands, same order, same
                 rule that a number appears exactly once — the P&L, the ROI and
                 the progress live in the header, so the foot never repeats
                 them, and the stop is a schedule pill rather than a held
                 field because it is what happens next, not what is owned. -->
            <div class="console-readout">
              <div class="readout-head">
                <span class="side-chip">
                  <span>{MISSION.market}</span>
                  <span class="side-chip-lev">{MISSION.leverage}</span>
                  <span>{MISSION.side}</span>
                </span>
                <!-- One reel walks the whole arc, and the container flashes
                     on the step that lands the target. -->
                <span class="readout-pnl" style={`${span(90, 96)}`}>
                  <span class="pnl-window"><span class="pnl-reel" style={`${span(63, 92)}`}>
                    {pnlArc.map((value) => (
                      <span class={value < 0 ? "pnl-step pnl-step--down" : "pnl-step"}>{usd(value)}</span>
                    ))}
                  </span></span>
                </span>
                <span class="readout-roi">
                  <span class="pnl-window"><span class="roi-reel" style={`${span(63, 92)}`}>
                    {roiArc.map((value) => (
                      <span class={value.startsWith("-") ? "pnl-step pnl-step--down" : "pnl-step"}>{value}</span>
                    ))}
                  </span></span>
                </span>

                <span class="readout-progress" style={`${span(61, 66)}`}>
                  <span class="progress-track"><span class="progress-fill" style={`${span(63, 92)}`}></span></span>
                  <span class="progress-label">
                    <span class="pnl-window"><span class="pct-reel" style={`${span(63, 92)}`}>
                      {pctArc.map((value) => <span class="pnl-step">{value}%</span>)}
                    </span></span>
                    <span>to target</span>
                  </span>
                </span>
              </div>

              <!-- The schedule. Left-aligned under its own label, the way
                   every other band on the panel starts at the same rule. -->
              <div class="readout-next">
                <span class="readout-legend">Next</span>
                {upNext.map((item) => (
                  <span class="next-pill" style={`${span(item.at, item.at + 6)}`}>
                    <span class="next-pill-label">{item.label}</span>
                    {item.detail && <span>{item.detail}</span>}
                  </span>
                ))}
              </div>

              <div class="readout-armed">
                <span class="readout-legend">Armed</span>
                {armedWatches.map((watch) => (
                  <div class="armed-row" style={`${span(watch.armedAt, watch.armedAt + 6)}`}>
                    {/* Glyph, description, the reading, the state — the app's
                        checklist row. Its threshold column is not repeated
                        here: the description already names the level, and this
                        panel is a third of the width the app gives the row. */}
                    {watch.metAt ? (
                      <span class="armed-swap armed-glyph">
                        <span class="armed-state armed-state--wait"
                          style={`${span(watch.metAt, watch.metAt + 4)}`}>○</span>
                        <span class="armed-state armed-state--met"
                          style={`${span(watch.metAt, watch.metAt + 5)}`}>✓</span>
                      </span>
                    ) : (
                      <span class="armed-glyph armed-state">○</span>
                    )}
                    <span class="armed-label">{watch.label}</span>
                    <span class="armed-read">
                      {watch.reads === null ? (
                        <span class="armed-read-none">-</span>
                      ) : watch.reads === "pnl" ? (
                        <span class="pnl-window"><span class="pnl-reel" style={`${span(63, 92)}`}>
                          {pnlArc.map((value) => (
                            <span class={value < 0 ? "pnl-step pnl-step--down" : "pnl-step"}>{usd(value)}</span>
                          ))}
                        </span></span>
                      ) : (
                        <span class="pnl-window"><span class="mark-reel" style={`${span(63, 92)}`}>
                          {markArc.map((value) => <span class="pnl-step">{value}</span>)}
                        </span></span>
                      )}
                    </span>
                    {/* A watch reads `waiting` until the market satisfies it,
                        then the two states cross over on that beat. */}
                    {watch.metAt ? (
                      <span class="armed-swap armed-tail">
                        <span class="armed-state armed-state--wait"
                          style={`${span(watch.metAt, watch.metAt + 4)}`}>waiting</span>
                        <span class="armed-state armed-state--met"
                          style={`${span(watch.metAt, watch.metAt + 5)}`}>met</span>
                      </span>
                    ) : (
                      <span class="armed-state armed-tail">waiting</span>
                    )}
                  </div>
                ))}
              </div>

              <div class="readout-held">
                <span class="readout-legend">Held</span>
                {heldStats.map((stat) => (
                  <span class="held-stat" style={`${span(stat.at, stat.at + 8)}`}>
                    {stat.term}
                    <b>
                      {stat.value ?? (
                        <span class="pnl-window"><span class="mark-reel" style={`${span(63, 92)}`}>
                          {markArc.map((value) => <span class="pnl-step">{value}</span>)}
                        </span></span>
                      )}
                    </b>
                  </span>
                ))}
              </div>
            </div>
              </div>
            </div>
          </div>

          <!-- The payoff. Every rule the page has been describing held, so it
               says so once, plainly, at the end of the run. -->
          <div class="console-success" style={`${span(93, 98)}`}>
            <svg class="tick tick--lg" style={`${span(94, 98)}`} viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3.4 8.5 6.6 11.6 12.6 4.8" pathLength="1" />
            </svg>
            <span class="success-head">Target hit at {px(MISSION.target)}</span>
            <span class="success-facts">
              <span>{usd(reward)} on the plan</span>
              <span>Stop never touched</span>
              <span>{rr.toFixed(1)}:1 as planned</span>
            </span>
          </div>

        </div>
      </div>
    </div>

    <!-- The three rules the run above never broke, so each one carries the
         same mark the console used to confirm them. -->
    <div class="container mission-notes">
      <div class="note" style={`${span(12, 40)}`}>
        <h3>
          <svg class="tick" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3.4 8.5 6.6 11.6 12.6 4.8" pathLength="1" />
          </svg>
          The exchange is the source of truth
        </h3>
        <p>
          Positions, orders, and fills are re-read from Hyperliquid after every submission,
          fill, reconnect, and restart. Local records never override it.
        </p>
      </div>
      <div class="note" style={`${span(20, 48)}`}>
        <h3>
          <svg class="tick" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3.4 8.5 6.6 11.6 12.6 4.8" pathLength="1" />
          </svg>
          Risk is counted before entry
        </h3>
        <p>
          Realised loss, paid fees, protected open risk, and pending-entry risk all draw down
          the same budget. Exhaust it and new exposure is blocked while stops stay in place.
        </p>
      </div>
      <div class="note" style={`${span(28, 56)}`}>
        <h3>
          <svg class="tick" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3.4 8.5 6.6 11.6 12.6 4.8" pathLength="1" />
          </svg>
          The stop is not advisory
        </h3>
        <p>
          It rests on Hyperliquid as a reduce-only order, and its size is reconciled against
          the position the exchange reports. It survives the app closing.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Live testnet band ─────────────────────────────────────── -->
  <section class="sec-tape" aria-label="Hyperliquid testnet markets">
    <div class="tape" id="tape" data-state="loading">
      <div class="tape-track">
        {[0, 1].map((copy) => (
          <div class="tape-run" aria-hidden={copy === 1 ? "true" : undefined}>
            {tapeMarkets.map((symbol) => (
              <span class="tape-item" data-symbol={symbol} data-copy={copy}>
                <span class="tape-sym">{symbol}</span>
                <span class="tape-px">- - - -</span>
                <span class="tape-chg">·</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="container tape-note">
      <p>
        Live mid prices from Hyperliquid testnet, the only network this alpha talks to.
        Testnet funds have no real-world value and there is no mainnet configuration.
      </p>
    </div>
  </section>

  <!-- ── The seventeen checks ──────────────────────────────────── -->
  <section id="rails" class="sec-checks">
    <div class="checks-scroller">
      <div class="checks-sticky">
        <div class="container checks-inner">
          <div class="checks-copy">
            <h2 class="section-title">Every entry passes the same seventeen checks.</h2>
            <p class="section-lede">
              Before signing a position-increasing order, T3 Trade re-checks mission status,
              authority, agent lease, direction, signer approval, data freshness, size, price,
              exchange minimums, leverage, notional, per-position risk, the loss budget,
              pending conflicts, and the stop. One failure rejects the order.
            </p>
            <ul class="rail-list">
              <li><strong>Every position increase carries a stop.</strong> T3 Trade submits an exchange-native reduce-only stop, then reconciles its size against the position Hyperliquid reports.</li>
              <li><strong>A retry is the same order.</strong> The client order ID and local request key are deterministic, so a resubmission cannot open a second position.</li>
              <li><strong>You keep the controls.</strong> Pause, cancel entries, reduce, close, and revoke all work with the agent CLI stopped.</li>
            </ul>
          </div>

          <div class="checks-visual">
            <div class="tile preview-card">
              <div class="preview-head">
                <span class="preview-title">trading_preview_order</span>
                <span class="preview-tally" aria-label="17 checks passing">
                  <span class="tally-window">
                    <span class="tally-reel">
                      {Array.from({ length: 18 }, (_, n) => <span>{n}</span>)}
                    </span>
                  </span>
                  <span class="tally-total">/ 17</span>
                </span>
              </div>

              <ul class="preview-list">
                {previewChecks.map((check, index) => (
                  <li style={`animation-range: cover ${16 + index * 5}% cover ${29 + index * 5}%`}>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    <span class="preview-check-label">{check.label}</span>
                    <span class="preview-check-detail">{check.detail}</span>
                  </li>
                ))}
              </ul>

              <div class="preview-verdict">
                <span class="preview-stamp">signed locally</span>
                <span class="preview-verdict-note">all seventeen passed</span>
              </div>
            </div>

            <div class="controls-strip">
              <span class="controls-strip-label">Operator controls</span>
              {controls.map((control, index) => (
                <span class="control-chip" style={`animation-range: cover ${56 + index * 3}% cover ${65 + index * 3}%`}>{control}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Harnesses ─────────────────────────────────────────────── -->
  <section id="harnesses" class="sec-harness">
    <div class="container">
      <h2 class="section-title kinetic">
        {kineticWords("Bring your own agent CLI.").map(({ word, range }) => (
          <>
            <span style={`animation-range: ${range}`}>{word}</span>{" "}
          </>
        ))}
      </h2>
      <p class="section-lede scrub">
        T3 Trade drives five CLIs already installed and authenticated on your machine. Three of
        them can run trading missions today. None of them ever receives the signer key.
      </p>

      <div class="harness-grid">
        {harnesses.map((harness, index) => (
          <div class="harness scrub" style={`animation-range: entry ${4 + index * 5}% cover ${26 + index * 5}%`}>
            <div class="harness-top">
