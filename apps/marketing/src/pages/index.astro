    flex: none;
    width: 15px;
    height: 15px;
    display: grid;
    place-items: center;
    border-radius: 4px;
    font-size: 9px;
    font-family: var(--font-mono);
    color: var(--fg-dim);
    background: rgba(255, 255, 255, 0.05);
  }

  .log-row--armed .log-rail { background: var(--warn); }
  .log-row--armed .log-glyph { color: var(--warn); background: color-mix(in srgb, var(--warn) 14%, transparent); }
  .log-row--fired .log-rail { background: var(--chart-blue); }
  .log-row--fired .log-glyph { color: var(--chart-blue); background: color-mix(in srgb, var(--chart-blue) 16%, transparent); }
  .log-row--check .log-rail { background: var(--ok); }
  .log-row--check .log-glyph { color: var(--ok); background: color-mix(in srgb, var(--ok) 14%, transparent); }
  .log-row--buy .log-rail { background: var(--chart-blue); }
  .log-row--buy .log-glyph { color: #fff; background: color-mix(in srgb, var(--chart-blue) 65%, transparent); }
  .log-row--stop .log-rail { background: var(--loss); }
  .log-row--stop .log-glyph { color: #fff; background: color-mix(in srgb, var(--loss) 60%, transparent); }
  .log-row--loss .log-rail { background: var(--loss); }
  .log-row--loss .log-glyph { color: var(--loss); background: color-mix(in srgb, var(--loss) 14%, transparent); }
  .log-row--win .log-rail { background: var(--ok); }
  .log-row--win .log-glyph { color: #04120b; background: var(--ok); }

  .log-text {
    flex: 1;
    min-width: 0;
    font-size: 11.5px;
    line-height: 1.35;
    color: var(--fg-muted);
    letter-spacing: -0.005em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .log-value {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .log-value--up { color: var(--ok); }
  .log-value--down { color: var(--loss); }

  .log-time {
    flex: none;
    width: 34px;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }

  /* ── Status bar ───────────────────────────────────────────── */
  .statusbar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.022);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-muted);
  }

  .status-main { min-width: 148px; }

  .sb-chip {
    padding: 2px 9px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 10px;
    color: var(--fg-dim);
  }

  .sb-pred {
    font-size: 10.5px;
    color: var(--fg-dim);
    font-variant-numeric: tabular-nums;
  }

  .sb-right {
    margin-left: auto;
    font-size: 10px;
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }

  /* ── Composer ─────────────────────────────────────────────── */
  .composer {
    padding: 9px 12px 8px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .composer-line {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 12px;
    color: var(--fg-faint);
  }

  .composer-caret {
    width: 1px;
    height: 13px;
    background: var(--fg-muted);
    animation: blink 1.1s steps(1, end) infinite;
  }

  .composer-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--fg-faint);
  }

  .composer-chip {
    padding: 1px 7px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-dim);
  }

  .composer-send {
    margin-left: auto;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: #04120b;
    font-size: 12px;
    font-weight: 600;
  }

  /* ── Chart card ───────────────────────────────────────────── */
  .console-chart {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0 12px 10px;
    overflow: hidden;
  }

  .chart-plot {
    position: relative;
    min-width: 0;
  }

  .chart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 2px 8px;
  }

  .chart-market {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
  }

  .chart-legend {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  /* The live figure at the top of the chart card, ticking on the same reel
     the readout reads. */
  .chart-price {
    font-family: var(--font-mono);
    font-size: 19px;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .chart-price .pnl-window { height: 1.3em; }
  .chart-price .pnl-step { color: inherit; text-align: left; }

  .chart-interval {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--fg-dim);
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  /* Scaling by aspect rather than a fixed height. A fixed height letterboxed
     the viewBox at narrow widths and left a band of dead space above the
     candles. */
  .chart-svg {
    width: 100%;
    height: auto;
    aspect-ratio: 900 / 330;
    display: block;
  }

  /* ── The price line, its wash, and the dot riding it ──────── */
  .price-line {
    fill: none;
    stroke: var(--ok);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .price-wash {
    fill: url(#washGrad);
    stroke: none;
    /* Rests uncovered to the plot's edge for browsers without timelines. */
    clip-path: inset(0 7.78% 0 0);
  }

  .price-dot {
    fill: var(--ok);
    stroke: #0a0a0c;
    stroke-width: 2;
    offset-rotate: 0deg;
    offset-distance: 100%;
  }

  .wedge {
    fill: url(#wedgeGrad);
  }

  .dip-dot { fill: var(--loss); }

  /* Same weight and dash as the levels it measures between. */
  .dip-drop {
    stroke: var(--loss);
    stroke-width: 1;
    stroke-dasharray: 4 4;
    opacity: 0.5;
  }

  .dip-label {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--loss);
    stroke: #0a0a0c;
    stroke-width: 4;
    paint-order: stroke fill;
  }

  /* This is the stop level lighting up, not a second line laid over it, so it
     keeps the level's dash. */
  .stop-hold {
    stroke: var(--loss);
    stroke-width: 2.5;
    stroke-dasharray: 4 4;
    opacity: 0;
  }

  .stop-hold-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--loss);
    stroke: #0a0a0c;
    stroke-width: 4;
    paint-order: stroke fill;
    opacity: 1;
  }

  /* ── The target prints ────────────────────────────────────── */
  .target-dot {
    fill: var(--ok);
    stroke: #0a0a0c;
    stroke-width: 2;
  }

  .target-ping {
    fill: none;
    stroke: var(--ok);
    stroke-width: 1.6;
    opacity: 0;
  }

  .target-check path {
    fill: none;
    stroke: #06120c;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  /* The payoff. Big, because it is the answer to the whole scroll. */
  .payoff {
    font-family: var(--font-mono);
    font-size: 68px;
    font-weight: 600;
    letter-spacing: -0.02em;
    fill: var(--ok);
    stroke: #0a0a0c;
    stroke-width: 9;
    paint-order: stroke fill;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* ── Risk and reward, to scale ────────────────────────────── */
  .rr {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 10px;
    padding-top: 11px;
    border-top: 1px solid var(--border);
  }

  .rr-bar {
    display: flex;
    flex: 1;
    height: 26px;
    border-radius: 6px;
    overflow: hidden;
  }

  .rr-seg {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 9px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
    min-width: 0;
    /* Each side is revealed by a wipe rather than a scale, so the figures
       stay at their true size while the bar measures itself out. */
    clip-path: inset(0);
  }

  .rr-cap {
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-size: 9px;
    opacity: 0.62;
  }

  .rr-val {
    margin-left: auto;
  }

  /* Both sides read outward from the entry, so the risk figure hugs the
     divider and the reward figure runs away from it. */
  .rr-seg--risk {
    background: color-mix(in srgb, var(--loss) 26%, transparent);
    color: color-mix(in srgb, var(--loss) 78%, white);
    flex-direction: row-reverse;
    border-right: 1px solid color-mix(in srgb, white 45%, transparent);
  }

  .rr-seg--risk .rr-val { margin-left: 0; margin-right: auto; }

  .rr-seg--reward {
    background: color-mix(in srgb, var(--accent) 24%, transparent);
    color: color-mix(in srgb, var(--accent) 82%, white);
  }

  .rr-note {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    font-size: 12px;
    color: var(--fg-dim);
    max-width: 30ch;
    line-height: 1.4;
  }

  .rr-note strong {
    color: var(--fg);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  /* ── Success marks ────────────────────────────────────────── */
  /* One glyph for every state that came out right. It rests drawn, so a
     browser without scroll timelines still shows a finished checkmark. */
  .tick {
    width: 12px;
    height: 12px;
    flex: none;
    overflow: visible;
  }

  .tick path {
    fill: none;
    stroke: var(--ok);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .tick--lg {
    width: 19px;
    height: 19px;
  }

  .tick--lg path { stroke-width: 2.1; }

  .rr-note .tick { margin-top: 2px; }

  .level line {
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }

  .grid line {
    stroke: rgba(255, 255, 255, 0.05);
    stroke-width: 1;
  }

  .grid text {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--fg-faint);
    opacity: 0.7;
  }

  .level--entry line { stroke: var(--fg-faint); }
  .level--stop line { stroke: var(--loss); }
  .level--target line { stroke: var(--ok); }
  .level--trigger line { stroke: var(--warn); }
  .level--wake line { stroke: var(--warn); opacity: 0.55; }

  .fire-dot { fill: var(--warn); }
  .fire-ping { fill: none; stroke: var(--warn); stroke-width: 1.5; opacity: 0; }

  /* ── The docked level chips ───────────────────────────────── */
  .chart-chips {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .chip {
    position: absolute;
    right: 4px;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 7px;
    border-radius: 6px;
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, #101113 76%, transparent);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-variant-numeric: tabular-nums;
    color: var(--fg-muted);
    white-space: nowrap;
  }

  .chip--target { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 40%, transparent); }
  .chip--armed { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 40%, transparent); }
  .chip--met { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 45%, transparent); background: color-mix(in srgb, var(--ok) 16%, #101113); }
  .chip--stop { color: var(--loss); border-color: color-mix(in srgb, var(--loss) 42%, transparent); }
  .chip--wake { color: var(--warn); }

  .chip--mark {
    color: #0b0f0d;
    background: var(--ok);
    border-color: var(--ok);
    font-weight: 600;
  }

  .chip--mark .pnl-window { height: 1.3em; }
  .chip--mark .pnl-step { color: inherit; text-align: left; }

  .chip--reassess {
    top: auto;
    bottom: 8px;
    right: 12%;
    transform: none;
    color: var(--warn);
    border-color: color-mix(in srgb, var(--warn) 38%, transparent);
    border-radius: 999px;
  }

  /* ── Positions card ───────────────────────────────────────── */
  .pos-card {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .pos-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px 6px;
  }

  .pos-unreal {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-size: 11.5px;
    color: var(--ok);
    transform-origin: 100% 50%;
  }

  .pos-usd { font-size: 12.5px; }

  .pos-cols,
  .pos-row {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.9fr) minmax(0, 0.7fr) minmax(0, 0.8fr) 44px;
    gap: 10px;
    align-items: center;
    padding: 5px 12px;
  }

  .pos-cols {
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-faint);
    border-bottom: 1px solid var(--border);
  }

  .pos-row {
    font-size: 11px;
    color: var(--fg-muted);
  }

  .pos-row + .pos-row {
    border-top: 1px solid color-mix(in srgb, var(--border) 45%, transparent);
  }

  .ta-r { text-align: right; }
  .ta-r .pnl-window { margin-left: auto; width: max-content; }
  .pos-time { color: var(--fg-faint); font-size: 10px; }
  .pos-none { color: var(--fg-faint); }

  .pos-state {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .pos-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 1px 7px;
    border-radius: 999px;
    font-size: 10px;
    color: var(--ok);
    border: 1px solid color-mix(in srgb, var(--ok) 40%, transparent);
    background: color-mix(in srgb, var(--ok) 9%, transparent);
    white-space: nowrap;
  }

  .pos-pill b {
    font-weight: 500;
    padding: 0 3px;
    border-radius: 3px;
    background: color-mix(in srgb, currentColor 16%, transparent);
  }

  .pos-token {
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .pos-token--open { color: var(--chart-blue); }
  .pos-token--working { color: var(--warn); }
  .pos-token--won { color: var(--ok); }

  /* The stop's row once the close makes it moot: settled, not alarming.
     Wins over the swap machinery's green met state. */
  .pos-token--done.armed-state--met { color: var(--fg-faint); }

  .pnl-window {
    display: block;
    height: 1.3em;
    overflow: hidden;
  }

  /* Both reels rest on their final stop, so a browser without scroll
     timelines shows the figure the run ends on rather than a zero it will
     never count up from. */
  .pnl-reel,
  .pct-reel,
  .mark-reel,
  .roi-reel {
    display: block;
    transform: translateY(calc(-32 * 1.3em));
  }

  .pnl-step {
    display: block;
    height: 1.3em;
    line-height: 1.3em;
    text-align: right;
    color: var(--ok);
  }

  /* The reel carries its own colour per stop, so the number turns red through
     the drawdown without a second animation. */
  .pnl-step--down { color: var(--loss); }

  /* The app's blue progress rule toward the target, under the log header. */
  .progress-track {
    flex: 1;
    height: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .progress-fill {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: 999px;
    background: var(--chart-blue);
    transform-origin: 0 50%;
  }

  .progress-label {
    flex: none;
    display: flex;
    align-items: baseline;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    color: var(--fg-dim);
    white-space: nowrap;
  }

  .progress-label .pnl-window { height: 1.3em; }
  .progress-label .pnl-step { color: inherit; }

  /* Two states occupying one cell, so a row never reflows when its state
     crosses over. Resting on the met state for browsers without timelines. */
  .armed-swap {
    position: relative;
    display: grid;
    flex-shrink: 0;
  }

  .armed-swap .armed-state {
    grid-area: 1 / 1;
  }

  .armed-state--met { color: var(--ok); }
  .armed-state--wait { opacity: 0; }

  /* ── The run came out clean ───────────────────────────────── */
  .console-success {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 12px;
    padding: 13px 16px;
    border: 1px solid color-mix(in srgb, var(--ok) 34%, transparent);
    border-radius: var(--radius-sm);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ok) 11%, transparent), transparent 62%),
      rgba(9, 9, 11, 0.9);
  }

  .success-head {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--ok) 55%, white);
    flex: none;
  }

  .success-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    color: var(--fg-dim);
  }

  /* ── Mission notes ────────────────────────────────────────── */
  /* One rule across the top and a divider between each note, so the three
     read as one group closing out the console rather than three columns
     floating below it. */
  .mission-notes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    padding-top: 0;
    padding-bottom: 76px;
    margin-top: 0;
    border-top: 1px solid var(--border);
  }

  .note {
    padding: 22px 30px 0 0;
  }

  .note + .note {
    padding-left: 30px;
    border-left: 1px solid var(--border);
  }

  .note h3 {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 15.5px;
    font-weight: 500;
    letter-spacing: -0.015em;
    margin-bottom: 7px;
  }

  .note h3 .tick {
    width: 13px;
    height: 13px;
    align-self: center;
  }

  .note p {
    color: var(--fg-muted);
    font-size: 14.5px;
    line-height: 1.6;
  }

  /* ── Checks ───────────────────────────────────────────────── */
  /* Not pinned. The console above already holds the reader still for three
     viewports, and a second pinned box left a screen of empty space between
     the two. This one scrubs as it enters, at normal section height. */
  .sec-checks {
    padding: 0;
    background: #08080a;
  }

  .checks-scroller {
    min-height: 0;
  }

  .checks-sticky {
    padding: 92px 0 104px;
  }

  .checks-inner {
    display: grid;
    grid-template-columns: 1fr 1.02fr;
    gap: 64px;
    align-items: center;
  }

  .rail-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 28px;
  }

  .rail-list li {
    color: var(--fg-muted);
    font-size: 15px;
    line-height: 1.55;
    padding-left: 18px;
    border-left: 2px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .rail-list strong {
    color: var(--fg);
    font-weight: 500;
  }

  .preview-card {
    padding: 20px;
    background: rgba(9, 9, 11, 0.7);
  }

  .preview-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
  }

  .preview-title {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  /* Odometer: a reel of digits translated by the same scroll timeline that
     ticks the checks, snapped to whole numbers. */
  .preview-tally {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }

  .tally-window {
    display: block;
    height: 1.25em;
    overflow: hidden;
  }

  /* Rests on 17 so a browser without scroll timelines shows the passing count
     rather than a zero it will never count up from. */
  .tally-reel {
    display: block;
    transform: translateY(calc(-17 * 1.25em));
  }

  .tally-reel span {
    display: block;
    height: 1.25em;
    line-height: 1.25em;
    font-variant-numeric: tabular-nums;
    text-align: right;
    min-width: 2ch;
  }

  .tally-total {
    color: var(--fg-dim);
    font-size: 11px;
  }

  .preview-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .preview-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .preview-list li svg {
    color: var(--ok);
    flex-shrink: 0;
  }

  .preview-check-label {
    color: var(--fg-muted);
    flex: 1;
  }

  .preview-check-detail {
    color: var(--fg-faint);
    font-size: 11px;
  }

  .preview-verdict {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  .preview-stamp {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 4px 10px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 999px;
  }

  .preview-verdict-note {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-dim);
  }

  .controls-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
  }

  .controls-strip-label {
    font-size: 12px;
    color: var(--fg-dim);
    margin-right: 4px;
  }

  .control-chip {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-muted);
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
  }

  /* ── Harnesses ────────────────────────────────────────────── */
  .harness-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin-top: 48px;
  }

  .harness {
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-right: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
    transition: background 0.2s ease;
  }

  .harness:last-child { border-right: 0; }
  .harness:hover { background: rgba(255, 255, 255, 0.035); }

  .harness-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .harness-mark {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
  }

  .harness-mark img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .harness-name {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* The command you already run to authenticate it. */
  .harness-cmd {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--fg-muted);
    padding: 6px 9px;
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--border);
    overflow-x: auto;
    white-space: nowrap;
  }

  .harness-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-top: auto;
  }

  .harness-tag--trades { color: var(--ok); }

  /* ── Signer key ───────────────────────────────────────────── */
  .arming-inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 64px;
    align-items: center;
  }

  .arming-card {
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .arming-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .arming-state {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .arming-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .arming-state--safe { color: var(--fg-muted); }
  .arming-state--safe .arming-dot { background: var(--fg-dim); }
  .arming-state--armed { color: var(--ok); }

  .arming-state--armed .arming-dot {
    background: var(--ok);
    animation: pulse 2s ease-in-out infinite;
  }

  .arming-desc {
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .arming-divider {
    height: 1px;
    background: var(--border);
  }

  /* ── Scope ────────────────────────────────────────────────── */
  .state-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 48px;
  }

  .state-card { padding: 26px 24px; }

  .state-card-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .state-card-label--is { color: var(--ok); }
  .state-card-label--isnt { color: var(--warn); }

  .state-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .state-card li {
    color: var(--fg-muted);
    font-size: 15px;
    line-height: 1.5;
    padding-left: 16px;
    position: relative;
  }

  .state-card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.66em;
    width: 6px;
    height: 1px;
    background: var(--fg-faint);
  }

  /* ── Open source ──────────────────────────────────────────── */
  .open-inner {
    max-width: 760px;
  }

  .open-eyebrow {
    color: var(--accent);
    margin-bottom: 16px;
  }

  .open-title {
    max-width: 20ch;
  }

  .open-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  /* ── Final CTA ────────────────────────────────────────────── */
  .sec-cta {
    text-align: center;
    padding: 130px 0;
    position: relative;
    overflow: hidden;
  }

  .sec-cta::before {
    content: "";
    position: absolute;
    inset: auto 0 -50% 0;
    height: 60%;
    background: radial-gradient(ellipse at center, var(--accent-dim) 0%, transparent 60%);
    pointer-events: none;
    opacity: 0.6;
  }

  .cta-inner { position: relative; }

  .cta-title {
    font-size: clamp(38px, 5.6vw, 66px);
  }

  .cta-sub {
    color: var(--fg-muted);
    font-size: 18px;
    max-width: 520px;
    margin: 20px auto 34px;
    line-height: 1.55;
    letter-spacing: -0.005em;
  }

  .cta-actions {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-release {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-dim);
    letter-spacing: 0.02em;
  }

  .cta-release span { color: var(--fg-muted); }

  .cta-install-label {
    margin: 26px 0 8px;
    color: var(--fg-dim);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  /* The command has to survive a phone without wrapping into nonsense, so it
     scrolls inside its own box rather than breaking mid-URL. */
  .cta-install {
    margin: 0 auto;
    max-width: 640px;
    overflow-x: auto;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.25);
    text-align: left;
  }

  .cta-install code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-muted);
    white-space: pre;
  }

  .cta-install--sm {
    margin-top: 14px;
    max-width: 560px;
  }

  .cta-note {
    margin: 26px auto 0;
    max-width: 560px;
    color: var(--fg-dim);
    font-size: 13px;
    line-height: 1.6;
  }

  .cta-note a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: rgba(161, 161, 170, 0.4);
    text-underline-offset: 3px;
  }

  .cta-note a:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  /* ── Scroll-driven layer ──────────────────────────────────────
     Everything below is scrubbed by the wheel or the finger. Without support
     the page renders at each animation's resting state, which is the final
     frame, so nothing is hidden from anyone. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* The tape only advances while the page is moving, so prices stay
         readable when the reader stops. */
      .tape-track {
        animation: tape-run linear both;
        animation-timeline: scroll(root block);
      }

      @keyframes tape-run {
        to { transform: translateX(-50%); }
      }

      /* ── The mission console ────────────────────────────────
         One pinned scroller drives everything: the candles, the four price
         levels and their labels, the watch that fires, the run, the counting
         PnL, the armed watches, and the rail that names the current beat.
         Each element carries its own slice as an inline animation-range, so
         the beats stay in step with each other. */
      .mission-scroller {
        view-timeline-name: --mission;
        view-timeline-axis: block;
      }

      .payoff,
      .grid,
      .level,
      .fire-dot,
      .fire-ping,
      .wedge,
      .chip,
      .dip,
      .stop-hold,
      .stop-hold-label,
      .target-hit,
      .target-ping,
      .target-check path,
      .pnl-reel,
      .pct-reel,
      .mark-reel,
      .roi-reel,
      .pos-unreal,
      .log-pnl,
      .progress-fill,
      .pos-row,
      .sb-pred,
      .armed-state--met,
      .armed-state--wait,
      .rr-seg,
      .console-success,
      .log-row,
      .mission-sticky .tick path {
        animation-timeline: --mission;
        animation-range: contain var(--from) contain var(--to);
      }

      /* The log and the positions card fill the way the checks list does:
         each row rises from a ghost of itself on its own beat. */
      .log-row,
      .pos-row,
      .sb-pred {
        animation-name: check-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      /* The price line, its wash, and the dot riding it own the whole pinned
         range; their choreography lives in the generated keyframes, measured
         from the path itself. */
      .price-line,
      .price-wash,
      .price-dot {
        animation-timeline: --mission;
        animation-range: contain 0% contain 100%;
        animation-fill-mode: both;
        animation-timing-function: linear;
      }

      .price-line { animation-name: price-draw; }
      .price-wash { animation-name: price-wash; }
      .price-dot { animation-name: price-ride; }

      /* Chips slide in from the gutter. The armed, met, and mark chips flash
         through instead: they retire once the story has moved past them. */
      .chip {
        animation-name: chip-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      @keyframes chip-in {
        from { opacity: 0; transform: translateY(-50%) translateX(10px); }
        to { opacity: 1; transform: translateY(-50%); }
      }

      .chip--armed,
      .chip--met,
      .chip--mark {
        animation-name: chip-flash;
      }

      @keyframes chip-flash {
        0% { opacity: 0; transform: translateY(-50%) translateX(10px); }
        10% { opacity: 1; transform: translateY(-50%); }
        84% { opacity: 1; transform: translateY(-50%); }
        100% { opacity: 0; transform: translateY(-50%); }
      }

      /* The reassess pill sits in the future gutter, not on a price row. It
         retires when the watch fires: the wake that follows makes its own
         appointment. */
      .chip--reassess {
        animation-name: reassess-flash;
      }

      @keyframes reassess-flash {
        0% { opacity: 0; }
        14% { opacity: 1; }
        86% { opacity: 1; }
        100% { opacity: 0; }
      }

      .wedge {
        animation-name: zone-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      /* The full-length tracks: the room dims while the story plays, the
         window sharpens into focus, and the sidebar status reel steps through
         its states. All three own the whole pinned range and put their
         choreography in the keyframes. */
      .mission-dim,
      .appwin,
      .status-reel {
        animation-timeline: --mission;
        animation-range: contain 0% contain 100%;
        animation-fill-mode: both;
        animation-timing-function: linear;
      }

      .mission-dim { animation-name: dim-hold; }

      @keyframes dim-hold {
        0% { opacity: 0; }
        7% { opacity: 0.85; }
        90% { opacity: 0.85; }
        100% { opacity: 0.55; }
      }

      .appwin { animation-name: win-live; }

      @keyframes win-live {
        0% {
          transform: scale(0.965) translateY(14px);
          box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.09),
            0 42px 110px -42px rgba(0, 0, 0, 0.95);
        }
        8% {
          transform: none;
        }
        86% {
          box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.09),
            0 42px 110px -42px rgba(0, 0, 0, 0.95);
        }
        94%, 100% {
          transform: none;
          box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.09),
            0 42px 110px -42px rgba(0, 0, 0, 0.95),
            0 0 90px -18px color-mix(in srgb, var(--ok) 34%, transparent);
        }
      }

      /* Stepped, so each state lands rather than slides: waiting until the
         watch arms at 18, armed until the fill at 47, live until the target
         at 91. */
      .status-reel { animation-name: status-walk; }

      @keyframes status-walk {
        0%, 17.9% { transform: translateY(0); }
        18%, 46.9% { transform: translateY(-1.5em); }
        47%, 90.9% { transform: translateY(-3em); }
        91%, 100% { transform: translateY(-4.5em); }
      }

      /* The number lands, overshoots, and settles into the glow it keeps. */
      .payoff {
        animation-name: payoff-land;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      @keyframes payoff-land {
        0% {
          opacity: 0;
          transform: scale(0.68);
          filter: none;
        }
        40% {
          opacity: 1;
          transform: scale(1.14);
          filter: drop-shadow(0 0 26px color-mix(in srgb, var(--ok) 80%, transparent));
        }
        70% { transform: scale(0.97); }
        100% {
          opacity: 1;
          transform: scale(1);
          filter: drop-shadow(0 0 14px color-mix(in srgb, var(--ok) 42%, transparent));
        }
      }

      @keyframes zone-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      .level {
        animation-name: level-draw;
        animation-timing-function: linear;
        animation-fill-mode: both;
        transform-origin: 0 50%;
      }

      @keyframes level-draw {
        from { opacity: 0; transform: scaleX(0.02); }
        to { opacity: 1; transform: scaleX(1); }
      }

      /* The watch firing is the one moment the page should feel like an
         event, so the marker lands and a ring leaves it. */
      .fire-dot {
        animation-name: zone-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      .fire-ping {
        animation-name: fire-ping;
        animation-timing-function: linear;
        animation-fill-mode: both;
        transform-origin: center;
        transform-box: fill-box;
      }

      @keyframes fire-ping {
        0% { opacity: 0; transform: scale(0.4); }
        12% { opacity: 0.9; transform: scale(0.55); }
        100% { opacity: 0; transform: scale(3.4); }
      }

      /* One reel, three phases, stepped so the digits land rather than
         slide: up to the open figure, down through the drawdown, out to
         the target. */
      .pnl-reel,
      .pct-reel,
      .mark-reel,
      .roi-reel {
        animation-name: pnl-count;
        animation-timing-function: steps(32, end);
        animation-fill-mode: both;
      }

      @keyframes pnl-count {
        from { transform: translateY(0); }
        to { transform: translateY(calc(-32 * 1.3em)); }
      }

      /* The flash on the step that lands the target. It overshoots, then
         settles into a soft glow it keeps. */
      .pos-unreal,
      .log-pnl {
        animation-name: pnl-flash;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      @keyframes pnl-flash {
        0% {
          transform: scale(1);
          filter: none;
        }
        45% {
          transform: scale(1.16);
          filter: drop-shadow(0 0 18px color-mix(in srgb, var(--ok) 75%, transparent));
        }
        100% {
          transform: scale(1);
          filter: drop-shadow(0 0 7px color-mix(in srgb, var(--ok) 30%, transparent));
        }
      }

      /* ── The drawdown and its drama ─────────────────────────
         The dip arrives at the low, and the stop flares at exactly the
         moment it is the only thing holding the position. */
      .grid,
      .dip,
      .target-hit {
        animation-name: zone-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      .stop-hold {
        animation-name: stop-flare;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      @keyframes stop-flare {
        0% { opacity: 0; stroke-width: 1; }
        40% { opacity: 1; stroke-width: 4; }
        100% { opacity: 0.32; stroke-width: 2; }
      }

      .stop-hold-label {
        animation-name: check-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      .target-ping {
        animation-name: target-ping;
        animation-timing-function: linear;
        animation-fill-mode: both;
        transform-origin: center;
        transform-box: fill-box;
      }

      @keyframes target-ping {
        0% { opacity: 0; transform: scale(0.5); }
        30% { opacity: 0.95; transform: scale(1.1); }
        100% { opacity: 0; transform: scale(3.6); }
      }

      .target-check path {
        stroke-dashoffset: 1;
        animation-name: scrub-draw;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      /* The two figures are measured outward from the entry divider, in the
         order the run creates them. A wipe keeps the numbers at true size,
         so the motion says "this much" rather than just moving. */
      .rr-seg {
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      .rr-seg--risk { animation-name: measure-down; }
      .rr-seg--reward { animation-name: measure-up; }

      @keyframes measure-down {
        from { clip-path: inset(0 0 0 100%); }
        to { clip-path: inset(0); }
      }

      @keyframes measure-up {
        from { clip-path: inset(0 100% 0 0); }
        to { clip-path: inset(0); }
      }

      /* Every checkmark draws itself. The slice comes from the `--from` and
         `--to` set on the svg above it, which custom properties inherit. */
      .mission-sticky .tick path {
        stroke-dashoffset: 1;
        animation-name: scrub-draw;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      .console-success {
        animation-name: success-land;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      @keyframes success-land {
        from {
          opacity: 0;
          transform: translateY(10px);
          border-color: var(--border);
        }
        to {
          opacity: 1;
          transform: none;
          border-color: color-mix(in srgb, var(--ok) 34%, transparent);
        }
      }

      /* The bar bends where the number does. The two stops are RUN_STEPS and
         RUN_STEPS + DIP_STEPS as a share of PNL_STEPS in the frontmatter
         (10/32 and 18/32), and the first value is the open PnL as a share of
         the reward. Retiming the reel means retiming these. */
      .progress-fill {
        animation-name: progress-arc;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      @keyframes progress-arc {
        0% { transform: scaleX(0); }
        31.25% { transform: scaleX(0.224); }
        56.25% { transform: scaleX(0); }
        100% { transform: scaleX(1); }
      }

      .armed-state--met {
        animation-name: zone-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      .armed-state--wait {
        animation-name: state-cleared;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      @keyframes state-cleared {
        from { opacity: 1; }
        to { opacity: 0; }
      }

      /* The three rules confirm themselves as the group comes into view. */
      .mission-notes {
        view-timeline-name: --notes;
        view-timeline-axis: block;
      }

      .note h3 .tick path {
        stroke-dashoffset: 1;
        animation-name: scrub-draw;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --notes;
        animation-range: cover var(--from) cover var(--to);
      }

      /* ── The seventeen checks ───────────────────────────────
         Not pinned. The checks tick, the reel counts to seventeen, and the
         controls arrive last, all across the card's own pass up the screen. */
      .checks-scroller {
        view-timeline-name: --checks;
        view-timeline-axis: block;
      }

      .preview-list li {
        animation: check-in linear both;
        animation-timeline: --checks;
      }

      @keyframes check-in {
        from { opacity: 0.12; transform: translateY(8px); }
        to { opacity: 1; transform: none; }
      }

      .tally-reel {
        animation: tally-count steps(17, end) both;
        animation-timeline: --checks;
        animation-range: cover 16% cover 56%;
      }

      @keyframes tally-count {
        from { transform: translateY(0); }
        to { transform: translateY(calc(-17 * 1.25em)); }
      }

      .preview-stamp {
        animation: stamp-land linear both;
        animation-timeline: --checks;
        animation-range: cover 56% cover 64%;
      }

      .preview-verdict-note {
        animation: check-in linear both;
        animation-timeline: --checks;
        animation-range: cover 60% cover 68%;
      }

      @keyframes stamp-land {
        from { opacity: 0; transform: scale(1.4) rotate(-5deg); }
        to { opacity: 1; transform: none; }
      }

      .control-chip {
        animation: check-in linear both;
        animation-timeline: --checks;
      }
    }
  }

  /* ── Responsive ───────────────────────────────────────────── */
  /* Pinning only works while the console fits the viewport it is pinned to.
