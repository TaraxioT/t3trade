---
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL, UPSTREAM_REPOSITORY_URL } from "../lib/site";

/* Headlines resolve one word at a time as the section scrolls past, so each
   word needs its own slice of the shared view timeline. */
function kineticWords(sentence: string) {
  return sentence.split(" ").map((word, index) => ({
    word,
    range: `entry ${10 + index * 3}% cover ${36 + index * 3}%`,
  }));
}

/* ── The mission console ───────────────────────────────────────────────────
   Every level, size, and dollar figure below is from the ETH mission in the
   hero screenshot, so the console and the screenshot describe the same run.
   The candles between those levels are drawn from a fixed seed at build time:
   the levels are the record, the shape between them is an illustration. */
const MISSION = {
  market: "ETH",
  leverage: "20x",
  side: "Long",
  size: 2.1766,
  entry: 1883.54,
  stop: 1874.94,
  wake: 1879.21,
  trigger: 1882.76,
  mark: 1888.8,
  target: 1907,
  liquidation: 1471.34,
  margin: 206,
};

const risk = (MISSION.entry - MISSION.stop) * MISSION.size; // 18.72
const reward = (MISSION.target - MISSION.entry) * MISSION.size; // 51.06
const open = (MISSION.mark - MISSION.entry) * MISSION.size; // 11.45

const usd = (value: number) => `${value >= 0 ? "+" : "-"}$${Math.abs(value).toFixed(2)}`;
const px = (value: number) =>
  value.toLocaleString("en-US", { maximumFractionDigits: 2 });
const rr = reward / risk;

/* The drawdown the position has to survive on the way to the target. It comes
   within six dollars of the stop without touching it, which is the whole
   argument for putting the stop on the exchange in the first place. */
const DIP_PRICE = 1880.4;
const dipPnl = (DIP_PRICE - MISSION.entry) * MISSION.size; // -6.84

const CANDLE_COUNT = 48;
const BREAK_INDEX = 33;

/* Anchored walk: a range, a shakeout under it, the reclaim, then the run. */
const ANCHORS: [number, number][] = [
  [0, 1881.2], [8, 1883.1], [14, 1880.4], [22, 1882.6], [27, 1877.1],
  [31, 1880.6], [33, 1883.6], [37, 1885.9], [41, 1887.3], [45, 1888.3], [47, 1888.8],
];

function missionSeries() {
  let seed = 20260814;
  const rand = () => {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 2147483648;
  };

  const at = (index: number) => {
    for (let a = 0; a < ANCHORS.length - 1; a += 1) {
      const [i0, p0] = ANCHORS[a];
      const [i1, p1] = ANCHORS[a + 1];
      if (index <= i1) return p0 + ((p1 - p0) * (index - i0)) / (i1 - i0);
    }
    return ANCHORS[ANCHORS.length - 1][1];
  };

  return Array.from({ length: CANDLE_COUNT }, (_, index) => {
    const openPrice = at(index) + (rand() - 0.5) * 0.5;
    const closePrice = at(index + 1) + (rand() - 0.5) * 0.5;
    return {
      open: openPrice,
      close: closePrice,
      high: Math.max(openPrice, closePrice) + rand() * 0.55,
      low: Math.min(openPrice, closePrice) - rand() * 0.55,
      up: closePrice >= openPrice,
    };
  });
}

const candles = missionSeries();

/* The domain reaches the target, so the whole arc fits in one frame: a tight
   range along the bottom, the break out of it, and a run that climbs most of
   the height. The app's chart draws one price line over an area wash, so the
   recorded walk holds the left of the plot and the plan holds the right, one
   line across both. */
const CHART_W = 900;
const CHART_H = 330;
const P_MIN = 1873.4;
const P_MAX = 1909.6;
const GUTTER = 70; // right-hand room for the docked level chips
const PLOT_W = CHART_W - GUTTER;
/* The record takes a little under three fifths of the plot, which leaves the
   plan enough room to walk at the same horizontal pace. */
const CANDLE_W = PLOT_W * 0.58;
const SLOT = CANDLE_W / CANDLE_COUNT;
const yOf = (price: number) => CHART_H - ((price - P_MIN) / (P_MAX - P_MIN)) * CHART_H;
const xOf = (index: number) => index * SLOT + SLOT / 2;

/* Where the record stops and the plan starts. The mark is the last price the
   exchange actually reported; everything to its right is what the target and
   the stop commit the mission to, drawn dashed and labelled as a plan. */
/* The low sits at t = 0.5 so the wipe uncovers it on the same scroll step the
   PnL reel bottoms out. The number and the line hit their worst point
   together, which is the whole reason the drawdown is here. */
/* Neither half of the run is a straight line. On the way down two bounces
   fail before the low; on the way up the break is retested and the run pulls
   back twice before the target prints. */
const PLAN: [number, number][] = [
  [0.0, MISSION.mark],
  [0.09, 1886.4],
  [0.18, 1888.2],
  [0.28, 1884.1],
  [0.37, 1886.3],
  [0.44, 1882.0],
  [0.5, DIP_PRICE],
  [0.57, 1885.0],
  [0.63, 1883.2],
  [0.71, 1890.8],
  [0.77, 1888.4],
  [0.85, 1897.9],
  [0.91, 1895.0],
  [1.0, MISSION.target],
];
const planX = (t: number) => CANDLE_W + (PLOT_W - CANDLE_W) * t;

const DIP_X = planX(0.5);
const TARGET_X = planX(1);

/* ── The price line, the way the app draws it ─────────────────────────────
   One polyline from the recorded closes into the plan's walk, an area wash
   under it, and a live dot riding the end of the stroke. The line draws
   itself along the pinned scroll: the keyframes below are generated from the
   path's own measured length, so each story beat lands on the exact fraction
   of ink it owns. */
const linePts: [number, number][] = [
  ...candles.map((candle, index) => [xOf(index), yOf(candle.close)] as [number, number]),
  ...PLAN.slice(1).map(([t, p]) => [planX(t), yOf(p)] as [number, number]),
];

const pricePath = linePts
  .map(([x, y], index) => `${index === 0 ? "M" : "L"}${x.toFixed(1)} ${y.toFixed(1)}`)
  .join(" ");

const washPath = `${pricePath} L${linePts[linePts.length - 1][0].toFixed(1)} ${CHART_H} L${linePts[0][0].toFixed(1)} ${CHART_H} Z`;

const cumulative: number[] = [0];
for (let index = 1; index < linePts.length; index += 1) {
  const [x0, y0] = linePts[index - 1];
  const [x1, y1] = linePts[index];
  cumulative.push(cumulative[index - 1] + Math.hypot(x1 - x0, y1 - y0));
}
const pathTotal = cumulative[cumulative.length - 1];
const fracAt = (index: number) => cumulative[index] / pathTotal;
const DIP_INDEX = CANDLE_COUNT + PLAN.findIndex(([t]) => t === 0.5) - 1;

/* Length fractions for the stroke and the dot, x fractions for the wash. */
const F = {
  range: fracAt(BREAK_INDEX),
  brk: fracAt(BREAK_INDEX + 2),
  mark: fracAt(CANDLE_COUNT - 1),
  dip: fracAt(DIP_INDEX),
};
const xInset = (index: number) => 100 - (linePts[index][0] / CHART_W) * 100;
const XI = {
  range: xInset(BREAK_INDEX),
  brk: xInset(BREAK_INDEX + 2),
  mark: xInset(CANDLE_COUNT - 1),
  dip: xInset(DIP_INDEX),
};
const pctOf = (value: number) => (value * 100).toFixed(2);

/* Beats: the range prints through the wait (2-18), holds while the thread
   sleeps, jumps on the break (32), climbs to the mark while the order is
   worked (40-66), falls into the drawdown (76), and runs out to the target
   (92). One set of stops, three properties. */
const chartKeyframes = `
@keyframes price-draw {
  0%, 2% { stroke-dashoffset: 1; }
  18% { stroke-dashoffset: ${(1 - F.range).toFixed(4)}; }
  32% { stroke-dashoffset: ${(1 - F.range).toFixed(4)}; }
  34% { stroke-dashoffset: ${(1 - F.brk).toFixed(4)}; }
  40% { stroke-dashoffset: ${(1 - F.brk).toFixed(4)}; }
  66% { stroke-dashoffset: ${(1 - F.mark).toFixed(4)}; }
  76% { stroke-dashoffset: ${(1 - F.dip).toFixed(4)}; }
  92%, 100% { stroke-dashoffset: 0; }
}
@keyframes price-ride {
  0%, 2% { offset-distance: 0%; }
  18% { offset-distance: ${pctOf(F.range)}%; }
  32% { offset-distance: ${pctOf(F.range)}%; }
  34% { offset-distance: ${pctOf(F.brk)}%; }
  40% { offset-distance: ${pctOf(F.brk)}%; }
  66% { offset-distance: ${pctOf(F.mark)}%; }
  76% { offset-distance: ${pctOf(F.dip)}%; }
  92%, 100% { offset-distance: 100%; }
}
@keyframes price-wash {
  0%, 2% { clip-path: inset(0 100% 0 0); }
  18% { clip-path: inset(0 ${XI.range.toFixed(2)}% 0 0); }
  32% { clip-path: inset(0 ${XI.range.toFixed(2)}% 0 0); }
  34% { clip-path: inset(0 ${XI.brk.toFixed(2)}% 0 0); }
  40% { clip-path: inset(0 ${XI.brk.toFixed(2)}% 0 0); }
  66% { clip-path: inset(0 ${XI.mark.toFixed(2)}% 0 0); }
  76% { clip-path: inset(0 ${XI.dip.toFixed(2)}% 0 0); }
  92%, 100% { clip-path: inset(0 ${((GUTTER / CHART_W) * 100).toFixed(2)}% 0 0); }
}`;

/* The chips docked in the chart's right gutter, the way the app docks its
   level chips: each at its price row, each arriving on its own beat. */
const chipTop = (price: number) => `top: ${((yOf(price) / CHART_H) * 100).toFixed(1)}%`;

/* The wedge the app projects ahead of a live position: from the mark out to
   the frame edge, opening between the target above and the stop below. */
const MARK_X = xOf(CANDLE_COUNT - 1);
const wedgePoints = [
  `${MARK_X.toFixed(1)},${yOf(MISSION.mark).toFixed(1)}`,
  `${PLOT_W},${yOf(MISSION.target).toFixed(1)}`,
  `${PLOT_W},${yOf(MISSION.stop).toFixed(1)}`,
].join(" ");

/* The agent log, in the app's own row grammar: a tone glyph, a rail, the
   sentence, and a right-aligned figure with its time. Each row owns the same
   slice of the pinned scroll that its chart annotation owns, so the feed and
   the chart never disagree about what has happened yet. */
type LogTone = "info" | "armed" | "fired" | "buy" | "stop" | "loss" | "check" | "win";
const LOG: { at: number; time: string; tone: LogTone; glyph: string; text: string; value: string; valueTone?: "up" | "down" }[] = [
  { at: 3, time: "14:02", tone: "info", glyph: "◈", text: "Mission created · long only, 20x ceiling", value: "$50 budget" },
  { at: 9, time: "14:03", tone: "info", glyph: "▤", text: "Plan published: long the range break", value: `→ ${px(MISSION.target)}` },
  { at: 18, time: "14:04", tone: "armed", glyph: "▲", text: "Watch armed · mark crosses above", value: px(MISSION.trigger) },
  { at: 32, time: "15:41", tone: "fired", glyph: "◉", text: "Watch fired · thread woken with fresh data", value: "1,882.9" },
  { at: 39, time: "15:41", tone: "check", glyph: "✓", text: "Preview passed · order signed locally", value: "17/17" },
  { at: 47, time: "15:41", tone: "buy", glyph: "B", text: `Bought to open ${MISSION.size} ETH`, value: px(MISSION.entry) },
  { at: 53, time: "15:42", tone: "stop", glyph: "S", text: "Reduce-only stop resting on-exchange", value: px(MISSION.stop) },
  { at: 76, time: "16:58", tone: "loss", glyph: "▼", text: "Drawdown held · stop untouched, nothing sold", value: usd(dipPnl), valueTone: "down" },
  { at: 91, time: "17:24", tone: "win", glyph: "S", text: `Sold to close ${MISSION.size} ETH at ${px(MISSION.target)}`, value: usd(reward), valueTone: "up" },
];

/* The sidebar the way the app draws it: this mission's thread lit, two older
   ones resting below it. The live row's status walks the same timeline the
   log does. */
const SIDE_THREADS = [
  { title: "Short SOL into funding flip", meta: "settled · 2d" },
  { title: "BTC range scalp, 15m", meta: "settled · 4d" },
];

/* Beats carry their slice as two custom properties. The pinned desktop
   layout maps them onto the `contain` range, and the un-pinned mobile layout
   maps the same numbers onto `cover`, so one set of timings drives both. */
const span = (from: number, to: number) => `--from:${from}%;--to:${to}%`;

/* The PnL walks the whole arc on one reel: up to the open figure, down
   through the drawdown, then out to the target. Each stop on the reel carries
   its own colour, so the number goes red when the position is under water
   without any extra machinery. */
const ramp = (from: number, to: number, steps: number) =>
  Array.from({ length: steps }, (_, step) => from + ((to - from) * (step + 1)) / steps);

/* 10 + 8 + 14 = 32 steps, the figure the pnl-count keyframes and every
   reel's resting transform are written against. */
const RUN_STEPS = 10;
const DIP_STEPS = 8;
const TARGET_STEPS = 14;

const pnlArc = [
  0,
  ...ramp(0, open, RUN_STEPS),
  ...ramp(open, dipPnl, DIP_STEPS),
  ...ramp(dipPnl, reward, TARGET_STEPS),
];

/* Progress toward the target, floored at zero. Below the entry there is no
   progress to report, and a negative percentage reads as a bug. */
const pctArc = pnlArc.map((value) => Math.max(0, Math.round((value / reward) * 100)));

/* Return on the margin the position ties up, which is the second figure the
   app's header prints next to the dollar one. It is the same reel divided by
   the same margin, so the two numbers can never disagree. */
const roiArc = pnlArc.map(
  (value) => `${value >= 0 ? "+" : "-"}${Math.abs((value / MISSION.margin) * 100).toFixed(2)}%`,
);

/* The mark the PnL implies, so the readout never claims a price and a profit
   that disagree. Step zero is the fill and the last step is the target. */
const markArc = pnlArc.map((value) => px(MISSION.entry + value / MISSION.size));

/* The 24h change the chart header prints next to the price, computed from the
   same reel so the two figures can never disagree. */
const DAY_OPEN = 1869.9;
const chgArc = pnlArc.map((value) => {
  const change = ((MISSION.entry + value / MISSION.size - DAY_OPEN) / DAY_OPEN) * 100;
  return `${change >= 0 ? "+" : ""}${change.toFixed(2)}%`;
});

/* The reel's two phase boundaries, RUN_STEPS/PNL_STEPS and
   (RUN_STEPS + DIP_STEPS)/PNL_STEPS, land at 31.25% and 56.25%. The
   progress-arc keyframes below bend at those same stops, so retiming the reel
   means retiming that keyframe too. */

/* The positions card's rows, in the app's own column grammar: the side pill,
   the state token, entry, notional, unrealised, and age. The open leg's state
   crosses from OPEN to CLOSED on the beat the target prints. */
const notional = (price: number) =>
  `$${Math.round(price * MISSION.size).toLocaleString("en-US")}`;

/* Six of the seventeen, named the way the preview tool names them. */
const previewChecks = [
  { label: "mission active, entries allowed", detail: "authority current" },
  { label: "market, side, and leverage allowed", detail: "within mandate" },
  { label: "account and order book fresh", detail: "live exchange data" },
  { label: "size, price, and minimum valid", detail: "exchange rules" },
  { label: "position and mission risk available", detail: "usd loss budget" },
  { label: "reduce-only stop attached", detail: "required" },
];

const controls = ["Pause", "Cancel entries", "Reduce 50%", "Close", "Revoke"];

/* Rendered as placeholders and filled in from the Hyperliquid testnet API on
   the client. If that call fails the band removes itself rather than show a
   number nobody can verify. */
const tapeMarkets = ["BTC", "ETH", "SOL", "HYPE", "AVAX", "LINK", "ARB", "DOGE"];

const harnesses = [
  { name: "Claude Code", command: "claude auth login", trades: true, icon: "claude-ai-icon.svg" },
  { name: "Codex CLI", command: "codex login", trades: true, icon: "openai_dark.svg" },
  { name: "OpenCode", command: "opencode auth login", trades: true, icon: "opencode-dark.svg" },
  { name: "Cursor", command: "agent login", trades: false, icon: "cursor_light.svg" },
  { name: "Grok CLI", command: "grok login", trades: false, icon: "grok-dark.svg" },
];
---

<Layout>
  <!-- The chart's generated keyframes: story beats mapped onto the measured
       length of the price path. Injected raw so the numbers computed in the
       frontmatter can drive keyframe stops, which custom properties cannot. -->
  <Fragment set:html={`<style>${chartKeyframes}</style>`} />

  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="container hero-inner">
      <p class="eyebrow hero-eyebrow">Open source · alpha · Hyperliquid testnet</p>

      <h1 class="hero-title display">
        The trading interface<br />for coding agents.
      </h1>

      <p class="hero-sub">
        Give an agent a mandate in plain English. T3 Trade holds it to hard limits and signs
        every order locally.
      </p>

      <div class="hero-actions">
        <a id="download-btn" href="https://github.com/TaraxioT/t3trade/releases" class="btn btn-primary btn-lg">
          <svg class="dl-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
          <span>Download for macOS</span>
        </a>
        <a class="hero-source-link" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
          <span>Run from source</span>
          <svg class="hero-source-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ── Live testnet band ─────────────────────────────────────── -->
  <section class="sec-tape" aria-label="Hyperliquid testnet markets">
    <div class="tape" id="tape" data-state="loading">
      <div class="tape-track">
        {[0, 1].map((copy) => (
          <div class="tape-run" aria-hidden={copy === 1 ? "true" : undefined}>
            {tapeMarkets.map((symbol) => (
              <span class="tape-item" data-symbol={symbol} data-copy={copy}>
                <span class="tape-sym">{symbol}</span>
                <span class="tape-px">- - - -</span>
                <span class="tape-chg">·</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="container tape-note">
      <p>
        Live mid prices from Hyperliquid testnet, the only network this alpha talks to.
        Testnet funds have no real-world value and there is no mainnet configuration.
      </p>
    </div>
  </section>

  <!-- ── Mission lifecycle ─────────────────────────────────────── -->
  <section id="missions" class="sec-mission">
    <div class="container">
      <h2 class="section-title kinetic">
        {kineticWords("Watch one mission run.").map(({ word, range }) => (
          <>
            <span style={`animation-range: ${range}`}>{word}</span>{" "}
          </>
        ))}
      </h2>
      <p class="section-lede scrub">
        A mission binds one agent thread to one market. This is the cockpit itself, replaying
        a testnet ETH run: keep scrolling and the log fills, the watch fires, the checks
        pass, and the chart earns its target.
      </p>
    </div>

    <!-- The window pins for the length of the story. Each beat owns a slice
         of this timeline, and the log, the chart, and the readout all move
         together on it. The dim layer behind the window is what makes the
         page recede while the app plays. -->
    <div class="mission-scroller">
      <div class="mission-sticky">
        <div class="mission-dim" aria-hidden="true"></div>
        <div class="container stage-container">
          <div class="appwin">
            <div class="appwin-titlebar">
              <span class="tl-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="tl-title">T3 Trade</span>
              <span class="tl-net">hyperliquid testnet</span>
            </div>

            <!-- The thread header, the app's own breadcrumb row with the
                 mission capsule on the right. -->
            <div class="appwin-crumb" aria-hidden="true">
              <span class="crumb-path">
                <span class="crumb-project">t3-trade-test</span>
                <span class="crumb-sep">/</span>
                <span class="crumb-title">Trade ETH on the 5m, long the range break</span>
              </span>
              <span class="crumb-capsule">
                <span class="status-window"><span class="status-reel">
                  <span class="status-step"><i class="status-dot status-dot--wait"></i>ETH · Waiting</span>
                  <span class="status-step status-step--armed"><i class="status-dot status-dot--armed"></i>ETH · Armed</span>
                  <span class="status-step status-step--long"><i class="status-dot status-dot--long"></i>ETH · Long 20x</span>
                  <span class="status-step status-step--won"><i class="status-dot status-dot--long"></i>ETH · Completed {usd(reward)}</span>
                </span></span>
              </span>
            </div>

            <div class="appwin-body">
              <!-- The sidebar, the way the app draws it: this mission's thread
                   lit and walking through its states, older threads at rest. -->
              <aside class="appwin-side" aria-hidden="true">
                <div class="side-brand"><span class="side-brand-mark">T3</span><span>Trade</span></div>
                <div class="side-search">Search</div>
                <div class="side-legend">Active</div>
                <div class="side-thread side-thread--live">
                  <span class="side-thread-title">Trade ETH on the 5m, long the range break</span>
                  <span class="side-status">
                    <span class="status-window"><span class="status-reel">
                      <span class="status-step"><i class="status-dot status-dot--wait"></i>waiting</span>
                      <span class="status-step status-step--armed"><i class="status-dot status-dot--armed"></i>armed</span>
                      <span class="status-step status-step--long"><i class="status-dot status-dot--long"></i>long 20x</span>
                      <span class="status-step status-step--won"><i class="status-dot status-dot--long"></i>{usd(reward)} · settled</span>
                    </span></span>
                  </span>
                </div>
                <div class="side-legend">Settled</div>
                {SIDE_THREADS.map((thread) => (
                  <div class="side-thread">
                    <span class="side-thread-title">{thread.title}</span>
                    <span class="side-thread-meta">{thread.meta}</span>
                  </div>
                ))}
              </aside>

              <!-- The main column holds the live panel the way the thread
                   does: chart and positions on the left, the agent log on the
                   right, the status bar and the composer beneath. -->
              <div class="appwin-main">
                <div class="panel-row">
                  <div class="chart-col">
            <figure class="console-chart">
              <div class="chart-head">
                <span class="chart-market">
                  <span class="chart-legend">ETH · USD</span>
                  <span class="chart-price">
