---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="T3 Trade · Trading Campus Diorama"
  description="An interactive isometric diorama of the T3 Trade trading campus: agents at work across research, risk, operations, and the Hyperliquid testnet bridge."
  pageClass="page-diorama"
>
  <section class="diorama-wrap">
    <p class="sr-only">
      An interactive isometric illustration of the T3 Trade trading campus. Coding agents work
      across districts for research, risk approval, operations, and MCP connections, with signed
      orders crossing a rail bridge to the Hyperliquid testnet. Every district can be explored
      with pointer drag, wheel zoom, and keyboard station focus.
    </p>
    <div class="diorama-host" data-diorama-host>
      <div class="diorama-loading" data-diorama-loading>
        <span class="diorama-spinner" aria-hidden="true"></span>
        <span class="diorama-loading-text">Loading the trading campus</span>
      </div>
      <div class="diorama-hud" data-diorama-hud></div>
      <div class="diorama-card" data-diorama-card></div>
    </div>
    <noscript>
      <p class="diorama-noscript">
        The trading campus diorama needs JavaScript and WebGL. The rest of the site works without
        them.
      </p>
    </noscript>
  </section>
</Layout>

<style>
  /* Nav is sticky at top with 12px inner padding, a 36px pill row, and a
     1px border: the host fills the remaining viewport. Desktop first. */
  .diorama-wrap {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 20px 32px 32px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .diorama-host {
    position: relative;
    width: 100%;
    min-height: 560px;
    height: calc(100dvh - 61px - 52px);
    background: #07111f;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    touch-action: none;
    overscroll-behavior: contain;
  }

  .diorama-host :global(canvas) {
    display: block;
  }

  /* HUD overlay plane: fills the host, lets drags pass through, and gives
     the absolutely positioned cluster a reliable anchor box. */
  .diorama-hud {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }

  .diorama-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    color: var(--fg-dim);
    font-size: 13px;
    background: #07111f;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 2;
  }

  .diorama-loading[hidden] {
    display: flex;
    opacity: 0;
  }

  .diorama-spinner {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--border-strong);
    border-top-color: var(--accent);
    animation: diorama-spin 0.9s linear infinite;
  }

  @keyframes diorama-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .diorama-spinner {
      animation-duration: 2.4s;
    }
  }

  .diorama-loading-text {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .diorama-hud,
  .diorama-card {
    position: absolute;
    z-index: 3;
    pointer-events: none;
  }

  .diorama-noscript {
    margin-top: 12px;
    font-size: 13px;
    color: var(--fg-dim);
  }

  @media (max-width: 820px) {
    .diorama-wrap {
      padding: 16px 20px 20px;
    }

    .diorama-host {
      height: calc(100dvh - 61px - 36px);
    }
  }
</style>

<script>
  // Lazy bootstrap: fonts first, then idle (or a short fallback), then the
  // dynamic import so pixi/gsap/howler never touch the landing page budget.
  // A module-level guard makes double init and double destroy impossible.
  let disposed = false;
  let started = false;
  let teardown: (() => void) | null = null;

  const boot = (): void => {
    if (disposed || started) return;
    started = true;
    const host = document.querySelector<HTMLElement>("[data-diorama-host]");
    if (!host) return;
    import("../diorama/main.js")
      .then(async (mod) => {
        if (disposed) return;
        await mod.initDiorama(host);
        if (disposed) {
          mod.destroyDiorama();
          return;
        }
        const loading = host.querySelector<HTMLElement>("[data-diorama-loading]");
        if (loading) loading.hidden = true;
        teardown = () => mod.destroyDiorama();
      })
      .catch((e: unknown) => {
        console.warn("[diorama] module load failed", e);
        const loading = host.querySelector<HTMLElement>("[data-diorama-loading]");
        if (loading) {
          loading.textContent = "The trading campus could not load in this browser.";
        }
      });
  };

  const destroy = (): void => {
    if (disposed) return;
    disposed = true;
    teardown?.();
    teardown = null;
  };

  const schedule = (): void => {
    if ("requestIdleCallback" in window) {
      requestIdleCallback(boot, { timeout: 1500 });
    } else {
      setTimeout(boot, 200);
    }
  };

  document.fonts.ready.then(schedule);

  document.addEventListener("astro:before-swap", destroy);
  window.addEventListener("pagehide", destroy);
  window.addEventListener("beforeunload", destroy);
</script>
