---
import "../diorama/page.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="A tiny bureau of agents researches, argues, stamps and ships one guarded trade, on loop."
    />
    <meta name="theme-color" content="#09090b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="The T3 Trade Bureau" />
    <meta
      property="og:description"
      content="A tiny bureau of agents researches, argues, stamps and ships one guarded trade, on loop."
    />
    <meta property="og:site_name" content="T3 Trade" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <title>The T3 Trade Bureau</title>
  </head>
  <body class="diorama-page">
    <main class="diorama" aria-label="The T3 Trade Bureau animated diorama">
      <a class="wordmark" href="/">T3 Trade</a>

      <div id="stage" class="stage"></div>

      <img
        id="fallback"
        class="fallback"
        data-src="/diorama/poster.webp"
        alt="The T3 Trade Bureau diorama"
        hidden
      />

      <p class="caption">
        <span class="caption-title">The T3 Trade Bureau</span>
        <span class="caption-body">A tiny bureau of agents researches, argues, stamps and ships one guarded trade, on loop.</span>
      </p>

      <div class="controls">
        <button id="pause" class="control" type="button" aria-pressed="false" disabled>
          Pause
        </button>
        <button id="sound" class="control" type="button" aria-pressed="false" disabled>
          Sound off
        </button>
      </div>

      <div id="loading" class="loading" role="region" aria-label="Loading the bureau">
        <div class="silhouette" aria-hidden="true">
          <div class="sil sil-deck"></div>
          <div class="sil sil-terrace"></div>
          <div class="sil sil-satellite"></div>
        </div>
        <div
          id="progress"
          class="progress"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          aria-label="Preparing the bureau"
        >
          <div class="progress-fill"></div>
        </div>
        <p id="status" class="status">Preparing the bureau</p>
      </div>

      <p id="announcer" class="sr-only" role="status" aria-live="polite"></p>

      <noscript>
        <!--
          The poster URL lives in an inline background-image, not an img src:
          the preload scanner would eagerly fetch noscript images even with
          scripting enabled. The JS failure path (ui.setFailed) is the only
          other consumer, and it assigns from #fallback data-src lazily.
        -->
        <div class="noscript">
          <div
            class="poster"
            style="background-image: url('/diorama/poster.webp')"
            role="img"
            aria-label="The T3 Trade Bureau diorama"
          ></div>
          <p>A tiny bureau of agents researches, argues, stamps and ships one guarded trade, on loop.</p>
        </div>
      </noscript>
    </main>

    <script>
      import { startDiorama } from "../diorama/main";

      const stage = document.getElementById("stage");
      if (stage) {
        const dispose = startDiorama(stage);
        let disposed = false;
        const cleanup = () => {
          if (disposed) return;
          disposed = true;
          dispose();
        };
        window.addEventListener("pagehide", cleanup);
        window.addEventListener("beforeunload", cleanup);
      }
    </script>
  </body>
</html>
