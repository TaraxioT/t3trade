---
import { COMPOSER } from "../../lib/mission";
import { beatPoint, rangeOf } from "../../lib/beats";
import { renderIcon } from "../../lib/icons";

/* The composer's one moment of life: while the position holds the mark
   (between the run and the wedge beats), a follow-up instruction types
   itself out, the send button fires, and the line clears. The typed span
   reveals via a stepped clip so it reads as typing; the reply lands in the
   agent log (see the "Follow-up received" row in lib/mission.ts). */
const MSG = "take profit at the target if the break holds";
/* Typing: 64 (a third into the 3-point run beat) to 69 (30% of the
   wedge beat). */
const msgTypeRange = rangeOf(beatPoint("run", 1 / 3), beatPoint("wedge-open", 0.3));
/* Visible from the first typed glyph to just after the send fires, then
   the line clears (71). */
const msgShowRange = rangeOf(beatPoint("run", 1 / 3), beatPoint("wedge-open", 0.5));
/* The send pop: one quick press-and-release as the last glyph lands. */
const sendRange = rangeOf(beatPoint("wedge-open", 0.3), beatPoint("wedge-open", 0.45));
---
<!-- The wakeup capsule the app floats above the composer while a scheduled
     reassessment is pending. -->
<div class="wakeup-cap" aria-hidden="true">
  <Fragment set:html={renderIcon("AlarmClock", { size: 14, strokeWidth: 2, class: "wakeup-ico" })} />
  Wakeup scheduled reassessment · BTC
  <Fragment set:html={renderIcon("ChevronRight", { size: 12, strokeWidth: 2, class: "wakeup-chev" })} />
</div>

<!-- The composer, resting under the panel the way it does in the thread.
     The .composer-msg overlay is the typed follow-up: it arrives over the
     placeholder on its own beat, types, and clears when the send fires. -->
<div class="composer" aria-hidden="true">
  <span class="composer-line">Ask anything, @tag files/folders, $use skills, or / for commands<span class="composer-caret"></span></span>
  <span class="composer-msg" style={msgShowRange}>
    <span class="msg-type" style={msgTypeRange}>{MSG}</span><span class="msg-caret"></span>
  </span>
  <span class="composer-meta">
    <span class="composer-chip">{COMPOSER.model}<Fragment set:html={renderIcon("ChevronDown", { size: 12, strokeWidth: 2, class: "chip-chev" })} /></span>
    <span class="composer-chip"><Fragment set:html={renderIcon("Lock", { size: 16, strokeWidth: 2, class: "chip-lead" })} />Full access</span>
    <span class="composer-meter" aria-hidden="true"><Fragment set:html={renderIcon("Gauge", { size: 16, strokeWidth: 2 })} /></span>
    <span class="composer-send" style={sendRange}><Fragment set:html={renderIcon("ArrowUp", { size: 14, strokeWidth: 2 })} /></span>
  </span>
</div>

<style>
  /* The wakeup capsule floating above the composer: the app's pending
     reassessment pill. */
  .wakeup-cap {
    display: flex;
    align-items: center;
    gap: 8px;
    width: max-content;
    margin: 0 auto 9px;
    padding: 4px 12px;
    border: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
    border-radius: calc(infinity * 1px);
    background: color-mix(in oklab, var(--card-app) 62%, transparent);
    backdrop-filter: blur(8px);
    font-size: 12.5px;
    line-height: 17px;
    color: var(--fg-muted);
  }

  .wakeup-ico { flex: none; color: var(--fg-muted); }
  .wakeup-chev { flex: none; color: var(--fg-muted); }

  /* ── Composer: the app's glass input card ─────────────────── */
  .composer {
    position: relative; /* the typed-message overlay anchors to the card */
    border: none;
    border-radius: 22px;
    background: color(srgb 0.0778016 0.0778173 0.0778187 / 0.8);
    backdrop-filter: blur(16px) saturate(1.08);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .composer-line {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 16px 16px 8px;
    font-size: 14px;
    line-height: 22.75px;
    color: var(--fg-muted);
  }

  .composer-caret {
    width: 1px;
    height: 13px;
    background: var(--fg-muted);
    animation: blink 1.1s steps(1, end) infinite;
  }

  /* The typed follow-up, laid exactly over the placeholder's text row. Its
     near-opaque glass tint hides the placeholder beneath while it types. */
  .composer-msg {
    position: absolute;
    top: 16px;
    left: 16px;
    right: 16px;
    height: 22.75px;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 0;
    font-size: 14px;
    line-height: 22.75px;
    color: var(--app-foreground);
    background: color(srgb 0.0778016 0.0778173 0.0778187 / 0.86);
    white-space: nowrap;
    overflow: hidden;
    opacity: 0;
  }

  .msg-type {
    display: inline-block;
    white-space: nowrap;
    clip-path: inset(0 100% 0 0);
  }

  .msg-caret {
    width: 1px;
    height: 13px;
    flex: none;
    background: var(--app-foreground);
  }

  .composer-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 7px;
    font-size: 14px;
    color: var(--fg-muted);
  }

  /* The app's composer controls: 28px ghost chips, hairline-radius. */
  /* The app's picker trigger anatomy: 16px provider icon, name, chevron,
     28px tall, radius 8, gap 6. */
  .composer-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 10px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    color: var(--fg-muted);
  }

  .chip-chev {
    flex: none;
    color: var(--fg-muted);
  }

  /* The permissions chip's leading lock glyph. */
  .chip-lead {
    flex: none;
    color: var(--fg-muted);
  }

  /* The runtime-mode control shows just the effort word; "Fast mode on"
     is the app's collapsed (screen-reader) label inside the same chip. */
  .composer-chip--runtime { gap: 6px; }

  .sr-word {
    width: 1px;
    height: 1px;
    overflow: hidden;
    display: block;
  }

  /* The token-meter ring beside the send button. */
  .composer-meter {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: calc(infinity * 1px);
    color: var(--fg-muted);
  }



  .composer-meter + .composer-send { margin-left: 0; }

  /* The send button: a full circle in the app's primary blue with a light
     arrow, not a green squircle. */
  .composer-send {
    margin-left: auto;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: calc(infinity * 1px);
    background: color-mix(in srgb, var(--chart-primary) 35%, transparent);
    color: var(--app-foreground);
    font-size: 14px;
    font-weight: 500;
  }

  /* ── Desktop surface ───────────────────────────────────────── */
  @media (min-width: 1081px) and (min-height: 861px) {
    /* The composer glass card the app centres under the thread: the
       chat-composer-glass-shell surface: a 22px-radius tint at 80% over
       a 16px blur, 768 wide, a 70px text row over a 48px control row. */
    .composer {
      width: 768px;
      max-width: 100%;
      height: 144px;
      margin: 5px auto 0;
      padding: 0;
      gap: normal;
      justify-content: space-between;
      border: none;
      border-radius: 22px;
      background: color(srgb 0.0778016 0.0778173 0.0778187 / 0.8);
      backdrop-filter: blur(16px) saturate(1.08);
      box-shadow: none;
    }

    .composer-line {
      margin: 0;
      padding: 16px 16px 8px;
      height: 94px;
      box-sizing: border-box;
      align-items: flex-start;
    }

    /* flex-start pins the caret to the row top while the glyphs centre in
       their 22.75px line box; nudge it down half the difference so the
       caret sits centred on the placeholder's first line, the way the
       app's own caret rides the text line. */
    .composer-line .composer-caret {
      margin-top: 4.875px;
    }

    .composer-meta {
      margin: 0;
      height: 48px;
      /* The app's control cluster bleeds 9px past the 16px shell inset
         on the left (negative-margin cluster), and its right cluster
         ends flush at the inset on the right. */
      padding: 0 16px 16px 7px;
      box-sizing: border-box;
    }
  }

  /* ── Responsive ────────────────────────────────────────────── */
  @media (max-width: 820px) {
    .composer { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .composer-caret {
      animation: none;
    }
  }

  /* ── The composer's scroll-driven beat ───────────────────────
     The typed line, its caret, and the send pop all ride the shared
     --mission timeline (declared on .mission-scroller), each with its own
     inline --from/--to slice from the beat table. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .composer-msg,
      .msg-type,
      .composer-send {
        animation-timeline: --mission;
        animation-range: contain var(--from) contain var(--to);
        animation-fill-mode: both;
      }

      /* Arrives with the first typed glyph, holds through the send pop,
         then clears: the sent message leaves the composer. */
      .composer-msg {
        animation-name: msg-show;
        animation-timing-function: linear;
      }

      @keyframes msg-show {
        0% { opacity: 0; }
        8% { opacity: 1; }
        85% { opacity: 1; }
        100% { opacity: 0; }
      }

      /* Stepped clip so the line types glyph by glyph instead of wiping. */
      .msg-type {
        animation-name: msg-type;
        animation-timing-function: steps(44, end);
      }

      @keyframes msg-type {
        from { clip-path: inset(0 100% 0 0); }
        to { clip-path: inset(0 0 0 0); }
      }

      /* One press-and-release as the last glyph lands. */
      .composer-send {
        animation-name: send-fire;
        animation-timing-function: linear;
      }

      @keyframes send-fire {
        0% { transform: none; }
        30% { transform: translateY(-2px) scale(0.9); }
        60% { transform: translateY(-3px) scale(1.08); }
        100% { transform: none; }
      }
    }
  }
</style>
