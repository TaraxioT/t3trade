---
import "../../styles/app-tokens.generated.css";
import "../../styles/replica.css";
import { BG_LINES, BG_LINES_RIGHT } from "../../lib/mission";
import { beatStart, STORY } from "../../lib/beats";
import AgentLog from "./AgentLog.astro";
import Chart from "./Chart.astro";
import Composer from "./Composer.astro";
import Positions from "./Positions.astro";
import StatusBar from "./StatusBar.astro";
import Topbar from "./Topbar.astro";

/* The status reel steps through waiting / armed / long / settled, each
   transition landing on its beat. Keyframe stops cannot read custom
   properties, so the em-based walk is generated here from the beat table and
   injected raw, the same mechanism the chart uses. */
const ARMED = beatStart(STORY.statusArmed);
const LONG = beatStart(STORY.statusLong);
const WON = beatStart(STORY.targetPrints);
/* The step lands a hair after its guard so the reel never rests between
   frames while a boundary scrolls past. */
const GUARD = 0.1;
const statusKeyframes = `
@keyframes status-walk {
  0%, ${ARMED - GUARD}% { transform: translateY(0); }
  ${ARMED}%, ${LONG - GUARD}% { transform: translateY(-1.5em); }
  ${LONG}%, ${WON - GUARD}% { transform: translateY(-3em); }
  ${WON}%, 100% { transform: translateY(-4.5em); }
}`;
---
<!-- The window. On the desktop surface (the media block further down) it is
     an elevated, edge-cropped app canvas: no sidebar, no breadcrumb, just the
     mission panel oversized with the capsule above and the composer below.
     Scoped to the cockpit subtree only: the app's own font stacks and the
     generated --app-* tokens, so the rest of the marketing page keeps its
     brand type. -->
<!-- The status walk's generated keyframes: beat starts mapped onto the
     reel's step offsets. Injected raw so keyframe stops can carry computed
     numbers. -->
<Fragment set:html={`<style>${statusKeyframes}</style>`} />
<div class="appwin">
  <div class="appwin-titlebar">
    <span class="tl-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="tl-title">T3 Trade</span>
    <span class="tl-net">hyperliquid testnet</span>
  </div>

  <div class="appwin-body">
    <div class="appwin-main">
      <!-- Quiet content behind the glass: soft colour pools and a muted
           transcript, so the card frost has something to refract instead of
           reading matte. The transcript lines are real mission sentences -
           they are legible at the replica's render size through the glass. -->
      <div class="appwin-bg" aria-hidden="true">
        <i class="appwin-bg-glow appwin-bg-glow--a"></i>
        <i class="appwin-bg-glow appwin-bg-glow--b"></i>
        <i class="appwin-bg-glow appwin-bg-glow--c"></i>
        <span class="appwin-bg-lines">
          {BG_LINES.map((line) => <i>{line}</i>)}
        </span>
        <span class="appwin-bg-lines appwin-bg-lines--right">
          {BG_LINES_RIGHT.map((line) => <i>{line}</i>)}
        </span>
      </div>
      <Topbar />

      <div class="panel-shell">
        <div class="panel-row">
          <div class="chart-col">
            <Chart />
            <Positions />
          </div>

          <AgentLog />
        </div>

        <StatusBar />
      </div>

      <Composer />
    </div>
  </div>
</div>

<style>
  .appwin {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--app-mission-panel-outline);
    border-radius: var(--app-radius-xl);
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.008) 46%),
      var(--app-background);
    /* The marketing frame's elevation: layered shadows tinted toward the
       page's near-black blue cast (never pure black, never a neon glow) and
       the app's own lit top edge from the panel bevel token. */
    box-shadow:
      inset 0 1px 0 var(--app-mission-panel-bevel),
      0 1px 2px rgb(9 9 11 / 0.5),
      0 10px 28px -10px rgb(9 9 11 / 0.62),
      0 40px 110px -28px rgb(8 8 12 / 0.85);
    font-family: var(--app-font-sans);
    --font-mono: var(--app-font-mono);
    /* The app's resolved dark inks, re-sourced from the generated token
       bridge (scripts/extract-app-tokens.mjs), never hand-typed. */
    --fg: var(--app-foreground);
    --fg-muted: var(--app-muted-foreground);
    --fg-dim: var(--app-muted-foreground);
    --fg-faint: var(--app-muted-foreground);
    --border: var(--app-border);
    --card-app: var(--app-card);
    --ok: var(--app-profit);
    --loss: var(--app-loss);
    --warn: var(--app-armed);
    --chart-blue: var(--app-info);
    --chart-primary: var(--app-primary);
    /* The app's mission-panel --foreground override: its own formula
       (card-foreground 94% mixed with card), computed from the bridge. */
    --fg-panel: color-mix(in oklch, var(--app-foreground) 94%, var(--app-card));
  }

  .appwin-titlebar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.018);
  }

  .tl-dots {
    display: inline-flex;
    gap: 6px;
  }

  .tl-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
  }

  .tl-dots i:nth-child(1) { background: #f2555a; }
  .tl-dots i:nth-child(2) { background: #f5b93e; }
  .tl-dots i:nth-child(3) { background: #43c465; }

  .tl-title {
    font-size: 12px;
    font-weight: 550;
    letter-spacing: -0.01em;
    color: var(--fg-muted);
  }

  .tl-net {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--warn);
    padding: 2px 8px;
    border: 1px solid color-mix(in srgb, var(--warn) 35%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--warn) 8%, transparent);
  }

  .appwin-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
    min-height: 0;
  }

  /* ── Main column and the panel region ─────────────────────── */
  .appwin-main {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    min-height: 0;
    padding: 0 12px 12px;
  }

  /* The mission panel wrapper. Transparent, gap 12, no chrome: on the
     desktop surface it stretches to fill the elevated window; in the stacked
     layout it dissolves so its children flow as before. */
  .panel-shell {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 0;
    color: var(--fg);
  }

  .panel-row {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 10px;
    align-items: stretch;
    min-height: 0;
  }

  .chart-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  /* ── The window's scroll-driven layer ──────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .appwin { animation-name: win-live; }

      /* The window arrives already scaled; the elevation shadow itself is
         static - only the settle transform animates. */
      @keyframes win-live {
        0% {
          transform: scale(0.965) translateY(14px);
        }
        8% {
          transform: none;
        }
        94%, 100% {
          transform: none;
        }
      }
    }
  }

  /* ── The desktop app surface ──────────────────────────────────
     A cropped, elevated cockpit canvas: the app's exact material and ink,
     sized to the viewport with breathing room for the layered shadow, the
     mission panel owning nearly all of it. Everything the diff records as
     geometry lives here; below these breakpoints the window falls back to
     the stacked layout. */
  @media (min-width: 1081px) and (min-height: 861px) {
    .appwin {
      display: flex;
      width: min(1440px, calc(100vw - 72px));
      height: min(900px, calc(100dvh - 64px));
      margin: 0 auto;
      background: var(--app-background);
      color: var(--fg);
    }

    /* The desktop-window chrome reduces to the traffic lights, docked to the
       topbar band's left edge. Title text and the net pill belong to the
       stacked layout only. */
    .appwin-titlebar {
      position: absolute;
      top: 17px;
      left: 16px;
      z-index: 6;
      gap: 3px;
      padding: 0;
      border: none;
      background: none;
      pointer-events: none;
    }

    .appwin-titlebar .tl-dots { gap: 3px; }

    .appwin-titlebar .tl-title,
    .appwin-titlebar .tl-net { display: none; }

    .appwin-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      height: 100%;
    }

    .appwin-main {
      position: relative;
      padding: 44px 20px 0;
      gap: 0;
    }

    /* The behind-the-glass content: two soft colour pools and a column
       of transcript lines at whisper opacity - enough for the card
       frost to refract, quiet enough to stay background. */
    .appwin-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .appwin-bg-glow {
      position: absolute;
      width: 640px;
      height: 480px;
      border-radius: 50%;
      filter: blur(90px);
    }

    /* Decorative pools mixed from the bridge tokens, so no literal app
       colour lives in this file. */
    .appwin-bg-glow--a {
      left: -120px;
      top: 60px;
      background: radial-gradient(closest-side, color-mix(in srgb, var(--app-info) 17%, transparent), transparent 70%);
    }

    .appwin-bg-glow--b {
      right: -80px;
      bottom: 40px;
      background: radial-gradient(closest-side, color-mix(in srgb, var(--app-profit) 12%, transparent), transparent 70%);
    }

    .appwin-bg-glow--c {
      left: 30%;
      bottom: -140px;
      width: 520px;
      height: 360px;
      background: radial-gradient(closest-side, color-mix(in srgb, var(--app-primary) 10%, transparent), transparent 70%);
    }

    .appwin-bg-lines {
      position: absolute;
      left: 36px;
      top: 110px;
      display: flex;
      flex-direction: column;
      gap: 30px;
      width: 660px;
      font-size: 16px;
      line-height: 21px;
      color: color-mix(in srgb, var(--app-foreground) 84%, var(--app-background));
      opacity: 0.26;
      /* The transcript is decoration behind the glass, and the cards on top
         move with the aspect: wherever a card edge falls mid-word, a raw
         clip would leave single-letter fragments reading in the gutters
         (seen at tall aspects as stray B/S/W/n marks). Both columns fade
         out at their outer edge instead, so the ink never ends on a hard
         letter cut at any viewport. */
      -webkit-mask-image: linear-gradient(to right, black, transparent);
      mask-image: linear-gradient(to right, black, transparent);
    }

    .appwin-bg-lines--right {
      left: auto;
      right: 60px;
      top: 150px;
      width: 420px;
      opacity: 0.22;
      -webkit-mask-image: linear-gradient(to left, black 40px, transparent 120px);
      mask-image: linear-gradient(to left, black 40px, transparent 120px);
    }

    .appwin-bg-lines i { font-style: normal; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .appwin-bg-lines i:nth-child(even) { width: 82%; }

    .panel-shell {
      flex: 1;
      min-height: 0;
      margin-top: 8px;
    }

    .panel-row {
      flex: 1;
      min-height: 0;
      grid-template-columns: minmax(0, 1fr) clamp(380px, 32%, 460px);
      gap: 16px;
    }

    /* The whole chain below the shell must be allowed to shrink past its
       content, or the grid's auto minimums blow the surface past the
       elevated frame. */
    .chart-col {
      min-height: 0;
    }
  }

  /* ── Responsive ────────────────────────────────────────────── */
  /* The behind-the-glass transcript only exists on the desktop surface,
     where its styling lives; below that it must not render as raw text. */
  .appwin-bg { display: none; }

  @media (min-width: 1081px) and (min-height: 861px) {
    .appwin-bg { display: block; }
  }

  @media (max-width: 1080px), (max-height: 860px) {
    /* The window focus only makes sense while pinned. */
    .appwin { animation: none; }
  }

  @media (max-width: 1080px) {
    /* One column: the chart leads, the positions follow, the log closes.
       The story still plays on the cover pass. */
    .appwin-body {
      grid-template-columns: 1fr;
    }

    .panel-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 820px) {
    /* Phone-width window: tighter chrome, smaller feed type. */
    .appwin-body {
      grid-template-columns: 1fr;
    }

    /* The phone's deliberate surface: the capsule, the chart, and the agent
       log. The positions table (five cramped columns) and the status bar
       (whose state reel the capsule already carries) do not come along;
       hiding them here, next to the layout that cannot seat them, keeps the
       collapse declared in the same component as the layout. */
    .appwin-body :global(.pos-card),
    .appwin-body :global(.statusbar),
    .appwin-body :global(.wakeup-cap) {
      display: none;
    }

    /* Card legends step up with the phone's larger relative scale. */
    .appwin-body :global(.card-legend) {
      font-size: 11.5px;
    }

    /* The phone cockpit is a pinned mini-stage: Mission.astro pins this
       window at a fixed height under the site nav (the titlebar drops; the
       capsule already names the app and the net), the chart sits at the
       top, and the agent log is a capped window whose feed streams inside
       it on the same beats. Only the stage geometry is phone-specific. */
    .appwin-titlebar {
      display: none;
    }

    .appwin {
      height: calc(100dvh - 60px);
    }

    .appwin-body {
      height: 100%;
    }

    .appwin-main {
      flex: 1;
      min-height: 0;
    }

    .panel-shell {
      flex: 1;
      min-height: 0;
    }

    .panel-row {
      grid-template-rows: auto minmax(0, 1fr);
    }
  }
</style>
