---
import { GITHUB_REPOSITORY_URL } from "../../lib/site";
import { renderIcon } from "../../lib/icons";
import Window from "../replica/Window.astro";
---
<!-- ── Hero ────────────────────────────────────────────────────
     github.com composition: centered headline block, then the
     whole cockpit as a STATIC framed product card below. The
     hero declares no timeline of any kind: with no --mission in
     scope the replica rests on its designed no-timeline frame
     (price line drawn, feed at its settled tail, marks banked),
     so the card is a composed still, mid-mission. The animated
     story lives only in the pinned Mission section. -->
<section class="hero">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-copy">
    <p class="eyebrow hero-eyebrow">Open source alpha, Hyperliquid testnet</p>

    <h1 class="hero-title display">
      The trading interface<br />for coding agents.
    </h1>

    <p class="hero-sub">
      Give an agent a mandate in plain English. T3 Trade holds it to hard limits and signs
      every order locally.
    </p>

    <div class="hero-actions">
      <a id="download-btn" href="https://github.com/TaraxioT/t3trade/releases" class="btn btn-primary btn-lg">
        <svg class="dl-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
        <span>Download for macOS</span>
      </a>
      <a class="hero-source-link" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
        <span>GitHub</span>
        <Fragment set:html={renderIcon("ArrowUpRight", { size: 13, class: "hero-source-arrow" })} />
      </a>
    </div>
  </div>

  <!-- The whole cockpit at product-card scale. zoom shrinks the
     frame (layout and all) until its masked bottom edge lands at
     or above the fold, so the first paint cuts nothing: the fade
     does the cutting. The decorative behind-the-glass transcript
     is hidden here; at card scale its clipped word-endings read
     as broken text in the panel seam, not as depth. -->
  <div class="hero-frame" aria-hidden="true">
    <!-- The backlight: a static diffuse aura behind the frame's
         upper perimeter, the reference's illumination in the
         page's own accent. Light, not motion - it never
         animates. -->
    <div class="hero-backlight"></div>
    <div class="hero-frame-shell">
      <div class="hero-scale">
        <Window />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 0 0 24px;
    border-top: 0;
    overflow: clip;
  }

  .hero-grid {
    position: absolute;
    inset: -10% 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 66% 52% at 50% 22%, black 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 66% 52% at 50% 22%, black 30%, transparent 100%);
  }

  /* The one wash of brand colour at the top of the page, pooled
     behind the centered headline block. */
  .hero-glow {
    position: absolute;
    inset: -20% -10% auto;
    height: 80%;
    pointer-events: none;
    background:
      radial-gradient(ellipse 46% 42% at 50% 0%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 70%);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    text-align: center;
    padding-top: clamp(3.75rem, 7vh, 6rem);
  }

  .hero-eyebrow,
  .hero-title,
  .hero-sub,
  .hero-actions {
    animation: fade-in 0.8s ease-out backwards;
  }

  .hero-title { animation-delay: 0.08s; }
  .hero-sub { animation-delay: 0.16s; }
  .hero-actions { animation-delay: 0.24s; }

  .hero-title {
    font-size: clamp(30px, 3.5vw, 48px);
    margin: 16px auto 18px;
    max-width: 17ch;
    text-wrap: balance;
    color: #fff;
  }

  .hero-sub {
    color: var(--fg-muted);
    font-size: clamp(15px, 1.15vw, 16.5px);
    max-width: 44ch;
    margin: 0 auto 24px;
    letter-spacing: -0.005em;
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px;
  }

  .dl-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .hero-source-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--fg-muted);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.18s ease;
  }

  .hero-source-link:hover {
    color: var(--fg);
  }

  :global(.hero-source-arrow) {
    flex-shrink: 0;
    opacity: 0.6;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  .hero-source-link:hover :global(.hero-source-arrow) {
    transform: translate(2px, -2px);
    opacity: 1;
  }

  /* ── The static cockpit card ───────────────────────────────
     The window keeps its own composed geometry (its rounded app
     border, its panels); zoom scales the whole frame, layout
     height included, down to product-card size so the masked
     bottom edge meets the fold on load. The fade is the only
     cut, and it starts above the fold. */
  .hero-frame {
    position: relative;
    z-index: 1;
    /* The card sits deliberately low: the fold lands inside the
       fade's span, so the composer is cut mid-content the way the
       reference truncates its editor, while the fade still starts
       above the fold and remains the softer of the two edges. */
    margin: clamp(88px, 11vh, 120px) auto 0;
    max-width: 1240px;
    padding-inline: 20px;
    mask-image: linear-gradient(180deg, black 0, black calc(100% - 140px), transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, black 0, black calc(100% - 140px), transparent 100%);
  }

  /* The backlight, strongest around the frame's upper perimeter
     and near-zero at the bottom, in the page's single accent.
     Static: it is light, not motion. */
  .hero-backlight {
    position: absolute;
    inset: -90px -70px auto;
    height: 78%;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(46% 58% at 50% 0%, color-mix(in srgb, var(--accent) 24%, transparent), transparent 72%),
      radial-gradient(78% 85% at 50% 0%, color-mix(in srgb, var(--accent) 11%, transparent), transparent 76%);
  }

  /* ── The glass demo frame ───────────────────────────────────
     A 24px top radius with a square bottom, a crisp neutral
     hairline on the lit edges, a subtle translucent lift over
     the dark page, and a uniform 20px inset from the glass to
     the cockpit on the top and both sides (the developer's one
     measured fix: left = right = top), with the bottom connected.
     Page chrome wears the marketing ladder (24 is the frame's
     documented one-off against the ladder clause); the cockpit
     inside keeps the app ladder, never mixed in one element. The
     bottom stays open: the fade remains the one thing that cuts
     the product. */
  .hero-frame-shell {
    padding: 20px 20px 0;
    border: 1px solid;
    border-bottom: 0;
    border-color: color-mix(in srgb, var(--border-strong) 60%, #fff 8%);
    border-radius: 24px 24px 0 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.028) 55%, rgba(255, 255, 255, 0.02));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .hero-scale {
    zoom: var(--hero-zoom, 1);
  }

  /* The window's own corners nest concentrically inside the
     frame's (12px inner rounding), square at the bottom where
     the media connects to the frame's open base. It fills the
     frame's content box exactly, so the glass-to-cockpit gap is
     the shell's own 20px padding on the top and both sides -
     one uniform measurement, not three. */
  .hero-frame :global(.appwin) {
    width: 100%;
    border-radius: 12px 12px 0 0;
  }

  /* At card scale the behind-the-glass transcript's clipped word
     endings surface in the chart/log seam and read as broken text,
     so the hero's copy of the window drops that decorative layer.
     The colour pools stay. */
  .hero-frame :global(.appwin-bg-lines) {
    display: none;
  }

  /* ── The watch-state rest frame ──────────────────────────────
     The card rests at the armed moment instead of the story's
     settled end, so the first paint reads "an agent watching a
     market". Two moves, both scoped to this instance only.

     First: the story animations are switched off. With no --mission
     timeline in scope the browser falls them back to the document
     timeline, where their fill: both pins every element at its
     100% (settled) keyframe. Killing them here - and only here -
     lets the components' own base styles speak; Mission's pinned
     story is untouched.

     Then: the base states are pointed at the armed beat. Every
     number below is a value the frozen replica itself computes
     for that beat - the 0.6205 stroke offset and the 62.68% wash
     clip are the generated price-draw / wash-clip keyframes' own
     18% (armed) stops, the -1.5em reel step is status-walk's
     armed step, and the feed shifts are the fixture's own row
     geometry (7 rows x 33.5px past the 14-row desktop page; the
     phone's 8/10-row pages at 45px). */
  .hero-frame :global(.appwin),
  .hero-frame :global(.grid),
  .hero-frame :global(.level),
  .hero-frame :global(.fire-dot),
  .hero-frame :global(.fire-ping),
  .hero-frame :global(.wedge),
  .hero-frame :global(.wedge-edge),
  .hero-frame :global(.chip),
  .hero-frame :global(.dip-dot),
  .hero-frame :global(.dip-drop),
  .hero-frame :global(.dip-label),
  .hero-frame :global(.stop-hold),
  .hero-frame :global(.stop-hold-label),
  .hero-frame :global(.target-dot),
  .hero-frame :global(.target-ping),
  .hero-frame :global(.target-check),
  .hero-frame :global(.pnl-track),
  .hero-frame :global(.progress-fill),
  .hero-frame :global(.pos-row),
  .hero-frame :global(.sb-pred),
  .hero-frame :global(.armed-stack),
  .hero-frame :global(.rr-seg),
  .hero-frame :global(.log-row),
  .hero-frame :global(.log-feed-inner),
  .hero-frame :global(.status-track),
  .hero-frame :global(.price-line),
  .hero-frame :global(.price-wash) {
    animation: none;
  }

  .hero .hero-frame :global(.status-track) {
    transform: translateY(-1.5em);
  }

  /* The money reels rest at their last step by base; at the armed
     moment every figure is still flat, so the reels rest at their
     first step (+$0.00, 0% to target, the pre-run mark). */
  .hero .hero-frame :global(.pnl-track) {
    transform: none;
  }

  /* The line's armed-state reveal is expressed as a view-box
     clip, not the stroke-dashoffset the running story uses: at
     the card's low zoom on the stacked surface, Chrome's
     dashoffset + non-scaling-stroke rasterization splits the
     stroke into two fragments (verified with offset/zoom probes).
     The clip is geometry and renders one continuous stroke at
     every zoom, ending on the same 62.68% edge the wash rests
     on. */
  .hero .hero-frame :global(.price-line) {
    stroke-dashoffset: 0;
    clip-path: view-box inset(0 62.68% 0 0);
  }

  .hero .hero-frame :global(.price-wash) {
    clip-path: inset(0 62.68% 0 0);
  }

  .hero .hero-frame :global(.log-feed-inner) {
    transform: translateY(-234.5px);
  }

  /* The log's progress bar and the rr tick are run-time ink; at
     the armed rest the bar is empty and the tick not yet drawn. */
  .hero .hero-frame :global(.progress-fill) {
    transform: scaleX(0);
  }

  .hero .hero-frame :global(.rr-note .tick) {
    display: none;
  }

  /* Everything below only exists after the watch fires: the
     entry, stop and wake levels, the projection wedge, the
     drawdown and target marks, the met / mark / entry / stop /
     wake chips, and the position rows the entry creates. */
  .hero-frame :global(.level--entry),
  .hero-frame :global(.level--stop),
  .hero-frame :global(.level--wake),
  .hero-frame :global(.wedge),
  .hero-frame :global(.wedge-edge),
  .hero-frame :global(.dip-drop),
  .hero-frame :global(.dip-dot),
  .hero-frame :global(.dip-label),
  .hero-frame :global(.stop-hold),
  .hero-frame :global(.stop-hold-label),
  .hero-frame :global(.fire-dot),
  .hero-frame :global(.fire-ping),
  .hero-frame :global(.target-ping),
  .hero-frame :global(.target-dot),
  .hero-frame :global(.target-check),
  .hero-frame :global(.chip--met),
  .hero-frame :global(.chip--mark),
  .hero-frame :global(.chip--entry),
  .hero-frame :global(.chip--stop),
  .hero-frame :global(.chip--wake),
  .hero-frame :global(.pos-row) {
    display: none;
  }

  /* The phone's shorter feed pages rest on the same row: their
     own row box (45px) and page sizes (8 rows, 10 above 401px). */
  @media (max-width: 820px) {
    .hero .hero-frame :global(.log-feed-inner) {
      transform: translateY(-585px);
    }

    @media (min-width: 401px) {
      .hero .hero-frame :global(.log-feed-inner) {
        transform: translateY(-495px);
      }
    }
  }

  /* Zoom per surface, tuned so frame bottom + fade sit at or
     above the fold at the canonical sizes (1440x900, 1280x800,
     390x844) and stay composed around them. */
  @media (min-width: 1081px) and (min-height: 861px) {
    .hero-scale { zoom: 0.52; }
  }

  @media (min-width: 1081px) and (min-height: 1100px) {
    .hero-scale { zoom: 0.66; }
  }

  /* Short-but-wide: the stacked window is taller than the pinned
     surface, so it scales a notch further to fit the fold. */
  @media (max-height: 860px), (max-width: 1080px) {
    .hero-scale { zoom: 0.37; }
  }

  @media (max-width: 820px) {
    .hero-scale { zoom: 0.51; }
  }

  @media (max-width: 820px) and (max-height: 740px) {
    .hero-scale { zoom: 0.42; }
  }

  /* ── Narrow viewports: same centered stack, one column ── */
  @media (max-width: 1080px) {
    .hero-copy {
      padding-top: 4.5rem;
    }

    .hero-title {
      font-size: clamp(28px, 7.4vw, 40px);
      max-width: 15ch;
    }

    .hero-sub {
      font-size: 15px;
      margin-bottom: 22px;
    }

    .hero-frame {
      margin-top: 84px;
      /* The shell now carries the side inset at these widths. */
      padding-inline: 0;
    }
  }

  /* Landscape phones: the copy tightens so the CTA stays above
     the fold; the card keeps its fit. */
  @media (max-width: 1080px) and (max-height: 520px) {
    .hero-copy {
      padding-top: 3rem;
    }

    .hero-title {
      font-size: clamp(26px, 5.4vw, 34px);
      margin: 10px auto 12px;
    }

    .hero-sub {
      margin-bottom: 14px;
    }

    .hero-frame {
      margin-top: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .hero-title,
    .hero-sub,
    .hero-actions {
      animation: none;
    }
  }
</style>
